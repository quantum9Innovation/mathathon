\glossaryentry{B-tangle?\glossaryentryfield{B-tangle}{\glsnamefont{$B$-tangle}}{a connected graph, $\psi \in \Occurs _B$, for which $\rho (H_\psi )\ge \rhoroot B$}{\relax }|setentrycounter[]{page}\glsnumberformat}{ix}
\glossaryentry{type?\glossaryentryfield{type}{\glsnamefont{type}}{the data associated to any closed walk in a graph which remembers the following information: the initial vertex, the vertices of length at least three, the (beaded) paths of the walk between such vertices (yielding a graph called the {\em type graph} of the walk, which is an oriented graph by orienting the edges by the direction in which they are first traversed; the order in which each of these vertices and paths are first encountered; and the $B$-neighbourhood of each vertex (the {\em lettering}). Alternatively, it is this data (an oriented graph, orderings of vertices and edges, and $B$-neighbourhood) as abstract data (not associated to a particular walk)}{\relax }|setentrycounter[]{page}\glsnumberformat}{x}
\glossaryentry{graph?\glossaryentryfield{graph}{\glsnamefont{graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G,\iota _G)$ where $(V_G,\Edir _G,h_G,t_G)$ is a directed graph (the {\em underlying directed graph}), and $\iota _G$ is a heads/tails reversing involution (sometimes called the {\em opposite map})}{\relax }|setentrycounter[]{page}\glsnumberformat}{3}
\glossaryentry{self-loop?\glossaryentryfield{self-loop}{\glsnamefont{self-loop}}{a directed edge or edge in a graph or directed graph whose head and tail are the same}{\relax }|setentrycounter[]{page}\glsnumberformat}{3}
\glossaryentry{whole-loop?\glossaryentryfield{whole-loop}{\glsnamefont{whole-loop}}{an edge in a graph which is paired (via the graph involution) with a different edge}{\relax }|setentrycounter[]{page}\glsnumberformat}{3}
\glossaryentry{half-loop?\glossaryentryfield{half-loop}{\glsnamefont{half-loop}}{an edge in a graph which is paired (via the graph involution) with itself}{\relax }|setentrycounter[]{page}\glsnumberformat}{3}
\glossaryentry{covering map?\glossaryentryfield{covering map}{\glsnamefont{covering map}}{a morphism of graphs or directed graphs that is an isomorphism on heads neighbourhoods and tails neighbourhoods of each vertex in the domain with that of its image}{\relax }|setentrycounter[]{page}\glsnumberformat}{3}
\glossaryentry{Broder-Shamir model?\glossaryentryfield{Broder-Shamir model}{\glsnamefont{Broder-Shamir model}}{our standard model, $\cC _n(B)$, of a covering map of degree $n$ to a graph, $B$ }{\relax }|setentrycounter[]{page}\glsnumberformat}{3}
\glossaryentry{Ramanujan graph?\glossaryentryfield{Ramanujan graph}{\glsnamefont{Ramanujan graph}}{a $d$-regular graph, for some integer $d$, such that all its adjacency eigenvalues, aside from $d$ and possibly $-d$, are at most $2(d-1)^{1/2}$ }{\relax }|setentrycounter[]{page}\glsnumberformat}{3}
\glossaryentry{Ramanujan graph?\glossaryentryfield{Ramanujan graph}{\glsnamefont{Ramanujan graph}}{a $d$-regular graph, for some integer $d$, such that all its adjacency eigenvalues, aside from $d$ and possibly $-d$, are at most $2(d-1)^{1/2}$ }{\relax }|setentrycounter[]{page}\glsnumberformat}{3}
\glossaryentry{etafund?\glossaryentryfield{etafund}{\glsnamefont{$\etafund (B)$}}{the order of the smallest strict tangle in $B$}{\relax }|setentrycounter[]{page}\glsnumberformat}{4}
\glossaryentry{bouquet whole?\glossaryentryfield{bouquet whole}{\glsnamefont{bouquet of $d/2$ whole-loops}}{the graph, $W_{d/2}$, which has one vertex and $d/2$ whole-loops (with $d$ even)}{\relax }|setentrycounter[]{page}\glsnumberformat}{8}
\glossaryentry{bouquet half?\glossaryentryfield{bouquet half}{\glsnamefont{bouquet of $d$ half-loops}}{the graph, $H_d$, which has one vertex and $d$ half-loops}{\relax }|setentrycounter[]{page}\glsnumberformat}{8}
\glossaryentry{Hashimoto matrix?\glossaryentryfield{Hashimoto matrix}{\glsnamefont{Hashimoto matrix}}{the adjacency matrix, $H_G$, of the directed line graph of $G$}{\relax }|setentrycounter[]{page}\glsnumberformat}{9}
\glossaryentry{Hashimoto matrix?\glossaryentryfield{Hashimoto matrix}{\glsnamefont{Hashimoto matrix}}{the adjacency matrix, $H_G$, of the directed line graph of $G$}{\relax }|setentrycounter[]{page}\glsnumberformat}{9}
\glossaryentry{directed graph?\glossaryentryfield{directed graph}{\glsnamefont{directed graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G)$ of a set of vertices, directed edges, and heads and tails maps}{\relax }|setentrycounter[]{page}\hyperit}{11}
\glossaryentry{graph?\glossaryentryfield{graph}{\glsnamefont{graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G,\iota _G)$ where $(V_G,\Edir _G,h_G,t_G)$ is a directed graph (the {\em underlying directed graph}), and $\iota _G$ is a heads/tails reversing involution (sometimes called the {\em opposite map})}{\relax }!directed edge?\glossarysubentryfield{1}{directed edge}{\glsnamefont{directed edge}}{the edge set of a directed graph, or, for a graph, that of its underlying directed graph}{\relax }|setentrycounter[]{page}\hyperit}{11}
\glossaryentry{self-loop?\glossaryentryfield{self-loop}{\glsnamefont{self-loop}}{a directed edge or edge in a graph or directed graph whose head and tail are the same}{\relax }|setentrycounter[]{page}\hyperit}{11}
\glossaryentry{undirected graph?\glossaryentryfield{undirected graph}{\glsnamefont{undirected graph}}{\nopostdesc }{\relax }|setentrycounter[]{page}\hyperit}{11}
\glossaryentry{graph?\glossaryentryfield{graph}{\glsnamefont{graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G,\iota _G)$ where $(V_G,\Edir _G,h_G,t_G)$ is a directed graph (the {\em underlying directed graph}), and $\iota _G$ is a heads/tails reversing involution (sometimes called the {\em opposite map})}{\relax }|setentrycounter[]{page}\hyperit}{11}
\glossaryentry{graph?\glossaryentryfield{graph}{\glsnamefont{graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G,\iota _G)$ where $(V_G,\Edir _G,h_G,t_G)$ is a directed graph (the {\em underlying directed graph}), and $\iota _G$ is a heads/tails reversing involution (sometimes called the {\em opposite map})}{\relax }!opposite map?\glossarysubentryfield{1}{opposite map}{\glsnamefont{opposite map}}{a heads/tail reversing involution that gives a directed graph the structure of a graph}{\relax }|setentrycounter[]{page}\hyperit}{11}
\glossaryentry{graph?\glossaryentryfield{graph}{\glsnamefont{graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G,\iota _G)$ where $(V_G,\Edir _G,h_G,t_G)$ is a directed graph (the {\em underlying directed graph}), and $\iota _G$ is a heads/tails reversing involution (sometimes called the {\em opposite map})}{\relax }!involution?\glossarysubentryfield{1}{involution}{\glsnamefont{involution}}{\nopostdesc }{\relax }|setentrycounter[]{page}\hyperit}{11}
\glossaryentry{half-loop?\glossaryentryfield{half-loop}{\glsnamefont{half-loop}}{an edge in a graph which is paired (via the graph involution) with itself}{\relax }|setentrycounter[]{page}\hyperit}{11}
\glossaryentry{whole-loop?\glossaryentryfield{whole-loop}{\glsnamefont{whole-loop}}{an edge in a graph which is paired (via the graph involution) with a different edge}{\relax }|setentrycounter[]{page}\hyperit}{11}
\glossaryentry{graph?\glossaryentryfield{graph}{\glsnamefont{graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G,\iota _G)$ where $(V_G,\Edir _G,h_G,t_G)$ is a directed graph (the {\em underlying directed graph}), and $\iota _G$ is a heads/tails reversing involution (sometimes called the {\em opposite map})}{\relax }!undirected edge?\glossarysubentryfield{1}{undirected edge}{\glsnamefont{undirected edge}}{\nopostdesc }{\relax }|setentrycounter[]{page}\glsnumberformat}{11}
\glossaryentry{edge?\glossaryentryfield{edge}{\glsnamefont{edge}}{{an orbit of the graph involution in a graph, i.e., a set of the form $\{e,\iota e\}$, where $e$ is a directed edge of the underlying directed graph and where $\iota $ is the opposite map} parent}{\relax }|setentrycounter[]{page}\hyperit}{11}
\glossaryentry{graph?\glossaryentryfield{graph}{\glsnamefont{graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G,\iota _G)$ where $(V_G,\Edir _G,h_G,t_G)$ is a directed graph (the {\em underlying directed graph}), and $\iota _G$ is a heads/tails reversing involution (sometimes called the {\em opposite map})}{\relax }!orientation?\glossarysubentryfield{1}{orientation}{\glsnamefont{orientation}}{the choice of one representative directed edge for an edge of a graph}{\relax }|setentrycounter[]{page}\hyperit}{11}
\glossaryentry{directed graph?\glossaryentryfield{directed graph}{\glsnamefont{directed graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G)$ of a set of vertices, directed edges, and heads and tails maps}{\relax }!morphism of directed graphs?\glossarysubentryfield{1}{morphism of directed graphs}{\glsnamefont{morphism of directed graphs}}{a set theoretic map of vertices and edges from one graph to another that preserves the heads and tails relations}{\relax }|setentrycounter[]{page}\hyperit}{12}
\glossaryentry{graph?\glossaryentryfield{graph}{\glsnamefont{graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G,\iota _G)$ where $(V_G,\Edir _G,h_G,t_G)$ is a directed graph (the {\em underlying directed graph}), and $\iota _G$ is a heads/tails reversing involution (sometimes called the {\em opposite map})}{\relax }!morphism of graphs?\glossarysubentryfield{1}{morphism of graphs}{\glsnamefont{morphism of graphs}}{a morphism of underlying directed graphs that preserves the opposite map}{\relax }|setentrycounter[]{page}\hyperit}{12}
\glossaryentry{graph?\glossaryentryfield{graph}{\glsnamefont{graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G,\iota _G)$ where $(V_G,\Edir _G,h_G,t_G)$ is a directed graph (the {\em underlying directed graph}), and $\iota _G$ is a heads/tails reversing involution (sometimes called the {\em opposite map})}{\relax }!oriented graph?\glossarysubentryfield{1}{oriented graph}{\glsnamefont{oriented graph}}{a graph with an orientation for each of its edges}{\relax }|setentrycounter[]{page}\hyperit}{12}
\glossaryentry{graph?\glossaryentryfield{graph}{\glsnamefont{graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G,\iota _G)$ where $(V_G,\Edir _G,h_G,t_G)$ is a directed graph (the {\em underlying directed graph}), and $\iota _G$ is a heads/tails reversing involution (sometimes called the {\em opposite map})}{\relax }!orientation?\glossarysubentryfield{1}{orientation}{\glsnamefont{orientation}}{the choice of one representative directed edge for an edge of a graph}{\relax }|setentrycounter[]{page}\hyperit}{12}
\glossaryentry{walk?\glossaryentryfield{walk}{\glsnamefont{walk}}{an alternating sequence of vertices and directed edges that ``follow in sequence,'' in a graph or directed graph}{\relax }|setentrycounter[]{page}\hyperit}{12}
\glossaryentry{walk?\glossaryentryfield{walk}{\glsnamefont{walk}}{an alternating sequence of vertices and directed edges that ``follow in sequence,'' in a graph or directed graph}{\relax }!interior vertex?\glossarysubentryfield{1}{interior vertex}{\glsnamefont{interior vertex}}{a vertex in a walk which is not the first or last vertex}{\relax }|setentrycounter[]{page}\hyperit}{12}
\glossaryentry{walk?\glossaryentryfield{walk}{\glsnamefont{walk}}{an alternating sequence of vertices and directed edges that ``follow in sequence,'' in a graph or directed graph}{\relax }!closed?\glossarysubentryfield{1}{closed}{\glsnamefont{closed}}{a walk whose first vertex equals its last}{\relax }|setentrycounter[]{page}\hyperit}{12}
\glossaryentry{walk?\glossaryentryfield{walk}{\glsnamefont{walk}}{an alternating sequence of vertices and directed edges that ``follow in sequence,'' in a graph or directed graph}{\relax }!reverse walk?\glossarysubentryfield{1}{reverse walk}{\glsnamefont{reverse walk}}{the reverse walk of a walk, $w$, in a graph is the walk where the order of the vertices and edges are reversed, and each edge is replaced by its opposite}{\relax }|setentrycounter[]{page}\hyperit}{12}
\glossaryentry{walk?\glossaryentryfield{walk}{\glsnamefont{walk}}{an alternating sequence of vertices and directed edges that ``follow in sequence,'' in a graph or directed graph}{\relax }!non-backtracking?\glossarysubentryfield{1}{non-backtracking}{\glsnamefont{non-backtracking}}{a walk where any two consecutive edges are not opposites}{\relax }|setentrycounter[]{page}\hyperit}{12}
\glossaryentry{walk?\glossaryentryfield{walk}{\glsnamefont{walk}}{an alternating sequence of vertices and directed edges that ``follow in sequence,'' in a graph or directed graph}{\relax }!strictly non-backtracking closed?\glossarysubentryfield{1}{strictly non-backtracking closed}{\glsnamefont{strictly non-backtracking closed}}{a closed, non-backtracking walk whose first and last edges are not opposites}{\relax }|setentrycounter[]{page}\hyperit}{12}
\glossaryentry{beaded path?\glossaryentryfield{beaded path}{\glsnamefont{beaded path}}{a walk in a graph, each of whose interior vertices have degree two; especially used in the type (graph) of a walk, where one deletes all or all but one vertices of degree two, which breaks the deleted vertices into interior vertices of beaded paths}{\relax }|setentrycounter[]{page}\hyperit}{12}
\glossaryentry{directed line graph?\glossaryentryfield{directed line graph}{\glsnamefont{directed line graph}}{the graph, $\Line (G)$, of a graph $G$ whose vertices are the directed edges of $G$, with an edge from $e_1$ to $e_2$ iff $h_G(e_1)=t_G(e_2)$ and $\iota _G(e_2)\ne \iota _G(e_1)$}{\relax }|setentrycounter[]{page}\hyperit}{13}
\glossaryentry{oriented line graph?\glossaryentryfield{oriented line graph}{\glsnamefont{oriented line graph}}{\nopostdesc }{\relax }|setentrycounter[]{page}\hyperit}{13}
\glossaryentry{Hashimoto matrix?\glossaryentryfield{Hashimoto matrix}{\glsnamefont{Hashimoto matrix}}{the adjacency matrix, $H_G$, of the directed line graph of $G$}{\relax }|setentrycounter[]{page}\hyperit}{13}
\glossaryentry{covering map?\glossaryentryfield{covering map}{\glsnamefont{covering map}}{a morphism of graphs or directed graphs that is an isomorphism on heads neighbourhoods and tails neighbourhoods of each vertex in the domain with that of its image}{\relax }|setentrycounter[]{page}\hyperit}{14}
\glossaryentry{etale map?\glossaryentryfield{etale map}{\glsnamefont{\'etale map}}{a morphism of graphs or directed graphs that is an injection on heads neighbourhoods and tails neighbourhoods of each vertex in the domain with that of its image}{\relax }|setentrycounter[]{page}\hyperit}{14}
\glossaryentry{permutation assignment?\glossaryentryfield{permutation assignment}{\glsnamefont{permutation assignment}}{a map $\Edir _B\to \cS _n$, used in defining the Broder-Shamir model, $\cC _n(B)$, of a random covering of degree $n$ of a graph, $B$}{\relax }|setentrycounter[]{page}\hyperit}{14}
\glossaryentry{asymptotic expansion?\glossaryentryfield{asymptotic expansion}{\glsnamefont{$1/n$-asymptotic expansion}}{an asymptotic expansion of a function $f(k,n)$ in powers of $1/n$ with coefficients being functions of $k$}{\relax }|setentrycounter[]{page}\glsnumberformat}{16}
\glossaryentry{old function?\glossaryentryfield{old function}{\glsnamefont{old function}}{a function on the vertices of a covering graph such that on all vertex fibres they are constant}{\relax }|setentrycounter[]{page}\hyperit}{16}
\glossaryentry{new function?\glossaryentryfield{new function}{\glsnamefont{new function}}{a function on the vertices of a covering graph such that on all vertex fibres their sum is zero}{\relax }|setentrycounter[]{page}\hyperit}{16}
\glossaryentry{new spectrum?\glossaryentryfield{new spectrum}{\glsnamefont{new spectrum}}{the part of the spectrum arising from new functions of a covering map}{\relax }|setentrycounter[]{page}\hyperit}{16}
\glossaryentry{old spectrum?\glossaryentryfield{old spectrum}{\glsnamefont{old spectrum}}{the part of the spectrum arising from old functions of a covering map}{\relax }|setentrycounter[]{page}\hyperit}{16}
\glossaryentry{variable-length graph?\glossaryentryfield{variable-length graph}{\glsnamefont{variable-length graph}}{a graph or directed graph whose edges or directed edges each have an associated length}{\relax }|setentrycounter[]{page}\hyperit}{17}
\glossaryentry{variable-length graph?\glossaryentryfield{variable-length graph}{\glsnamefont{variable-length graph}}{a graph or directed graph whose edges or directed edges each have an associated length}{\relax }!realization of a variable-length graph?\glossarysubentryfield{1}{realization of a variable-length graph}{\glsnamefont{realization of a variable-length graph}}{the graph, $\VLG (G,\vec k)$, by taking a directed or undirected variable-length graph and replacing each edge, $e$, by a path of length $k(e)$}{\relax }|setentrycounter[]{page}\hyperit}{17}
\glossaryentry{Broder-Shamir model?\glossaryentryfield{Broder-Shamir model}{\glsnamefont{Broder-Shamir model}}{our standard model, $\cC _n(B)$, of a covering map of degree $n$ to a graph, $B$ }{\relax }|setentrycounter[]{page}\hyperit}{18}
\glossaryentry{subgraphs occurring in a B covering?\glossaryentryfield{subgraphs occurring in a B covering}{\glsnamefont{subgraphs occurring in a $B$ covering}}{the subgraphs occurring in $\cC _n(B)$ for some $n$, where $\cC _n(B)$ is the Broder-Shamir model or a related model}{\relax }|setentrycounter[]{page}\hyperit}{23}
\glossaryentry{occurs-B?\glossaryentryfield{occurs-B}{\glsnamefont{$\Occurs _B$}}{a graph which is a subgraph of some element of $\cC _n(B)$}{\relax }|setentrycounter[]{page}\hyperit}{23}
\glossaryentry{order?\glossaryentryfield{order}{\glsnamefont{order}}{$\ord (G)=-\chi (G)$, minus the Euler characteristic of $G$, i.e., $"|E_G"|-"|V_G"|$}{\relax }|setentrycounter[]{page}\hyperit}{23}
\glossaryentry{tangle of B?\glossaryentryfield{tangle of B}{\glsnamefont{tangle of $B$}}{a graph, $\psi \in \Occurs _B$ for which $\rho (H_\psi )\ge \rhoroot B$}{\relax }|setentrycounter[]{page}\hyperit}{23}
\glossaryentry{B-tangle?\glossaryentryfield{B-tangle}{\glsnamefont{$B$-tangle}}{a connected graph, $\psi \in \Occurs _B$, for which $\rho (H_\psi )\ge \rhoroot B$}{\relax }|setentrycounter[]{page}\hyperit}{23}
\glossaryentry{tangle of B?\glossaryentryfield{tangle of B}{\glsnamefont{tangle of $B$}}{a graph, $\psi \in \Occurs _B$ for which $\rho (H_\psi )\ge \rhoroot B$}{\relax }!strict tangle of B?\glossarysubentryfield{1}{strict tangle of B}{\glsnamefont{strict tangle of $B$}}{a graph, $\psi $, in $\Occurs _B$ for which $\rho (H_\psi )> \rhoroot B$}{\relax }|setentrycounter[]{page}\hyperit}{23}
\glossaryentry{B-eps-tangle?\glossaryentryfield{B-eps-tangle}{\glsnamefont{$(B,\epsilon )$-tangle}}{a connected graph, $\psi \in \Occurs _B$, for which $\rho (H_\psi )\ge \epsilon +\rhoroot B$}{\relax }|setentrycounter[]{page}\hyperit}{23}
\glossaryentry{bouquet whole?\glossaryentryfield{bouquet whole}{\glsnamefont{bouquet of $d/2$ whole-loops}}{the graph, $W_{d/2}$, which has one vertex and $d/2$ whole-loops (with $d$ even)}{\relax }|setentrycounter[]{page}\glsnumberformat}{24}
\glossaryentry{graph of a walk?\glossaryentryfield{graph of a walk}{\glsnamefont{graph of a walk}}{the subgraph, $\Graph (w)$, traced out by a walk, $w$, in a graph}{\relax }|setentrycounter[]{page}\hyperit}{25}
\glossaryentry{loop?\glossaryentryfield{loop}{\glsnamefont{loop}}{a strictly non-backtracking closed walk each of whose vertices have degree two}{\relax }|setentrycounter[]{page}\hyperit}{25}
\glossaryentry{coincidence?\glossaryentryfield{coincidence}{\glsnamefont{coincidence}}{a value, $i$, for which the head of the $i$-th edge in a random walk was already visited in the walk, but the value of this $i$-th edge was not determined}{\relax }|setentrycounter[]{page}\hyperit}{27}
\glossaryentry{B-Ramanujan function?\glossaryentryfield{B-Ramanujan function}{\glsnamefont{$B$-Ramanujan function}}{a function with a polyexponential part in the eigenvalues $\mu _i(B)$ and an error term}{\relax }|setentrycounter[]{page}\hyperit}{28}
