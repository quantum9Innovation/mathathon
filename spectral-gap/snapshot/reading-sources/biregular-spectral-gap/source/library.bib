  doi = {10.1001/archneurpsyc.1956.02330240017002},
  abstract = {$<$p$>$In a recent report concerning the reversibility by chlorpromazine of psychoses induced by means of mescaline and\emph{d}-lysergic acid diethylamide (LSD-25), careful attention was given to the clinical and electroencephalographic changes.\textsuperscript{1}Although the clinical changes of this reversal effect were immediate and striking, the conventional electroencephalographic changes were minimal, and it was difficult to assess them. It was noted in another recent study that mescaline and LSD-25 failed to activate temporal-lobe epilepsy either clinically or electroencephalographically.\textsuperscript{2}$<$/p$><$p$>$Because of these factors, it was hoped that depth electrographic studies might be fruitful in elucidating the effects of these drugs. It was hoped also that study by means of depth electrography of the effects of adrenochrome might elucidate its reported actions of inducing a psychosis without insight in volunteers\textsuperscript{3}and increasing the paroxysmal discharges in the electroencephalograms of epileptics.\textsuperscript{4}Scalp electroencephalography and depth electrography were undertaken as specific$<$/p$>$},
