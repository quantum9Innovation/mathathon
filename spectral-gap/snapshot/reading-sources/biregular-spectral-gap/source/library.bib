@article{litvak2016,
  title = {Anti-Concentration Property for Random Digraphs and Invertibility of Their Adjacency Matrices},
  volume = {354},
  issn = {1631-073X},
  doi = {10.1016/j.crma.2015.12.002},
  abstract = {Let Dn,d be the set of all directed d-regular graphs on n vertices. Let G be a graph chosen uniformly at random from Dn,d and M be its adjacency matrix. We show that M is invertible with probability at least 1-Cln3⁡d/d for C$\leq$d$\leq$cn/ln2⁡n, where c,C are positive absolute constants. To this end, we establish a few properties of directed d-regular graphs. One of them, a Littlewood\textendash{}Offord-type anti-concentration property, is of independent interest: let J be a subset of vertices of G with |J|$\leq$cn/d. Let $\delta$i be the indicator of the event that the vertex i is connected to J and $\delta$=($\delta$1,$\delta$2,\ldots,$\delta$n)$\in$\{0,1\}n. Then $\delta$ is not concentrated around any vertex of the cube. This property holds even if a part of the graph is fixed.
R\'esum\'e
Soit Dn,d l'ensemble des graphes orient\'es d-r\'eguliers \`a n sommets. Soit G un \'el\'ement choisi uniform\'ement au hasard dans Dn,d et M sa matrice d'adjacente. On montre que M est inversible avec probabilit\'e sup\'erieure \`a 1-Cln3⁡d/d pour C$\leq$d$\leq$cn/ln2⁡n, o\`u c,C sont des constantes universelles positives. Afin d'\'etablir ce r\'esultat, nous montrons certaines propri\'et\'es des graphes orient\'es d-r\'eguliers. Parmi celles-ci, une propri\'et\'e d'anti-concentration de type Littlewood\textendash{}Offord. Soit J un sous-ensemble de sommets de G de taille |J|$\leq$cn/d. Soit $\delta$i l'indicateur du fait que le sommet i est connect\'e \`a J ; on note $\delta$=($\delta$1,$\delta$2,\ldots,$\delta$n)$\in$\{0,1\}n. On montre alors que $\delta$ n'est concentr\'e autour d'aucun sommet du cube. Cette propri\'et\'e reste vraie si une partie du graphe est fix\'ee.},
  number = {2},
  journal = {Comptes Rendus Mathematique},
  author = {Litvak, Alexander E. and Lytova, Anna and Tikhomirov, Konstantin and {Tomczak-Jaegermann}, Nicole and Youssef, Pierre},
  month = feb,
  year = {2016},
  pages = {121-124},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/ZVG2UJBU/S1631073X15003295.html}
}

