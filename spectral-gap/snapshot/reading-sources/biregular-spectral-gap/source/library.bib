@article{ravikumar2010,
  title = {High-Dimensional {{Ising}} Model Selection Using $\mathscr{l}$1-Regularized Logistic Regression},
  volume = {38},
  issn = {0090-5364, 2168-8966},
  doi = {10.1214/09-AOS691},
  abstract = {We consider the problem of estimating the graph associated with a binary Ising Markov random field. We describe a method based on $\mathscr{l}$1-regularized logistic regression, in which the neighborhood of any given node is estimated by performing logistic regression subject to an $\mathscr{l}$1-constraint. The method is analyzed under high-dimensional scaling in which both the number of nodes p and maximum neighborhood size d are allowed to grow as a function of the number of observations n. Our main results provide sufficient conditions on the triple (n, p, d) and the model parameters for the method to succeed in consistently estimating the neighborhood of every node in the graph simultaneously. With coherence conditions imposed on the population Fisher information matrix, we prove that consistent neighborhood selection can be obtained for sample sizes n=$\Omega$(d3log\,p) with exponentially decaying error. When these same conditions are imposed directly on the sample matrices, we show that a reduced sample size of n=$\Omega$(d2log\,p) suffices for the method to estimate neighborhoods consistently. Although this paper focuses on the binary graphical models, we indicate how a generalization of the method of the paper would apply to general discrete Markov random fields.},
  language = {EN},
  number = {3},
  journal = {The Annals of Statistics},
  author = {Ravikumar, Pradeep and Wainwright, Martin J. and Lafferty, John D.},
  month = jun,
  year = {2010},
  keywords = {Graphical models,Markov random fields,convex risk minimization,high-dimensional asymptotics,model selection,structure learning,ℓ_1-regularization},
  pages = {1287-1319},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/8GAEZFJU/euclid.aos.1268056617.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/AK57XIII/1268056617.html}
}

