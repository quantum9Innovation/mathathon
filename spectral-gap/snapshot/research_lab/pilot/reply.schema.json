{
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "summary", "target", "argument", "claims", "sources", "strongest_objection", "next_action", "code"],
  "properties": {
    "action": {"type": "string", "enum": ["checkpoint", "compute", "finish"]},
    "summary": {"type": "string"},
    "target": {"type": "string"},
    "argument": {"type": "string"},
    "claims": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "status", "dependencies", "evidence", "objection"],
      "properties": {
        "id": {"type": "string"}, "statement": {"type": "string"},
        "status": {"type": "string", "enum": ["sourced", "derived", "conjectural", "blocked"]},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "string"}, "objection": {"type": "string"}
      }
    }},
    "sources": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "url", "pinpoint", "supports", "checked"],
      "properties": {
        "title": {"type": "string"}, "url": {"type": "string"},
        "pinpoint": {"type": "string"}, "supports": {"type": "string"},
        "checked": {"type": "boolean"}
      }
    }},
    "strongest_objection": {"type": "string"},
    "next_action": {"type": "string"}, "code": {"type": "string"}
  }
}
