@article{aspvall1984,
  title = {Graph {{Coloring Using Eigenvalue Decomposition}}},
  volume = {5},
  issn = {0196-5212},
  doi = {10.1137/0605051},
  abstract = {Determining whether the vertices of a graph can be colored using k different colors so that no two adjacent vertices receive the same color is a well-known NP-complete problem. Graph coloring is also of practical interest (for example, in estimating sparse Jacobians and in scheduling), and many heuristic algorithms have been developed. We present a heuristic algorithm based on the eigenvalue decomposition of the adjacency matrix of a graph. Eigenvectors point out ``bipartite-looking'' subgraphs that are used to refine the coloring to a valid coloring. The algorithm optimally colors complete k-partite graphs and certain other classes of graphs with regular structure.,   Determining whether the vertices of a graph can be colored using k different colors so that no two adjacent vertices receive the same color is a well-known NP-complete problem. Graph coloring is also of practical interest (for example, in estimating sparse Jacobians and in scheduling), and many heuristic algorithms have been developed. We present a heuristic algorithm based on the eigenvalue decomposition of the adjacency matrix of a graph. Eigenvectors point out ``bipartite-looking'' subgraphs that are used to refine the coloring to a valid coloring. The algorithm optimally colors complete k-partite graphs and certain other classes of graphs with regular structure.},
  number = {4},
