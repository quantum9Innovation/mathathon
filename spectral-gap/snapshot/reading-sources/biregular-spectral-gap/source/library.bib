  pmid = {23580521}
}

@article{ramirez2003,
  title = {Commentary on the Definition of Eupnea and Gasping},
  volume = {139},
  issn = {1569-9048},
  doi = {10.1016/S1569-9048(03)00195-2},
  abstract = {Despite clear qualitative differences, it has proven difficult to identify criteria that reliably differentiate eupnea and gasping\textemdash{}particularly when multiple species or experimental preparations are considered. From a motor control perspective, this is unsurprising. Three organizational rules are common to nearly all rhythmic activities: (1) the basic rhythm is produced by a small network of cells, (2) the activity of this network in isolation often differs dramatically from the behavior of the whole animal, and (3) the rhythmogenic networks responsible for related behaviors are not fixed and independent but dynamically modifiable and overlapping. In this context, it becomes clear that the definition of a particular pattern and the investigation of the mechanisms underlying its production are inseparable. Rather than attempting to rigidly apply criteria developed using any one experimental preparation, the classification of respiratory patterns must evolve alongside our understanding of how each pattern is produced\textemdash{}a process that is only aided by investigations using a variety of experimental preparations.},
  number = {1},
  journal = {Respiratory Physiology \& Neurobiology},
  author = {Ramirez, Jan-Marino and Lieske, Steven P.},
  month = dec,
  year = {2003},
  keywords = {Brainstem; pre-Bötzinger nucleus,Control of breathing; central pattern generator,Disease; dyspnea,Pattern of breathing; eupnea},
  pages = {113-119},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/HZI47FH9/Ramirez and Lieske - 2003 - Commentary on the definition of eupnea and gasping.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/BBTNKSTQ/S1569904803001952.html}
}

