  title = {Convergence of the {{Population Dynamics}} Algorithm in the {{Wasserstein}} Metric},
  abstract = {We study the convergence of the population dynamics algorithm, which produces sample pools of random variables having a distribution that closely approximates that of the \{$\backslash$em special endogenous solution\} to a stochastic fixed-point equation of the form: \$\$R$\backslash$stackrel\{$\backslash$mathcal D\}\{=\} $\backslash$Phi( Q, N, $\backslash$\{ C\_i $\backslash$\}, $\backslash$\{R\_i$\backslash$\}),\$\$ where \$(Q, N, $\backslash$\{C\_i$\backslash$\})\$ is a real-valued random vector with \$N $\backslash$in $\backslash$mathbb\{N\}\$, and \$$\backslash$\{R\_i$\backslash$\}\_\{i $\backslash$in $\backslash$mathbb\{N\}\}\$ is a sequence of i.i.d. copies of \$R\$, independent of \$(Q, N, $\backslash$\{C\_i$\backslash$\})\$; the symbol \$$\backslash$stackrel\{$\backslash$mathcal\{D\}\}\{=\}\$ denotes equality in distribution. Specifically, we show its convergence in the Wasserstein metric of order \$p\$ (\$p $\backslash$geq 1\$) and prove the consistency of estimators based on the sample pool produced by the algorithm.},
  journal = {arXiv:1705.09747 [math]},
  author = {{Olvera-Cravioto}, Mariana},
  month = may,
  year = {2017},
  keywords = {Mathematics - Probability},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/JG98M5ZL/Olvera-Cravioto - 2017 - Convergence of the Population Dynamics algorithm i.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/Z84PIC53/1705.html}
}

@article{kuehn2017,
  archivePrefix = {arXiv},
  eprinttype = {arxiv},
  eprint = {1703.06740},
  title = {Heterogeneous Micro-Structure of Percolation in Sparse Networks},
  volume = {118},
  issn = {0295-5075, 1286-4854},
  doi = {10.1209/0295-5075/118/68003},
  abstract = {We examine the heterogeneous responses of individual nodes in sparse networks to the random removal of a fraction of edges. Using the message-passing formulation of percolation, we discover considerable variation across the network in the probability of a particular node to remain part of the giant component, and in the expected size of small clusters containing that node. In the vicinity of the percolation threshold, weakly non-linear analysis reveals that node-to-node heterogeneity is captured by the recently introduced notion of non-backtracking centrality. We supplement these results for fixed finite networks by a population dynamics approach to analyse random graph models in the infinite system size limit, also providing closed-form approximations for the large mean degree limit of Erd$\backslash$H\{o\}s-R$\backslash$'enyi random graphs. Interpreted in terms of the application of percolation to real-world processes, our results shed light on the heterogeneous exposure of different nodes to cascading failures, epidemic spread, and information flow.},
  number = {6},
  journal = {EPL (Europhysics Letters)},
  author = {Kuehn, Reimer and Rogers, Tim},
  month = jun,
  year = {2017},
  keywords = {Condensed Matter - Statistical Mechanics},
  pages = {68003},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/I927UHL4/Kuehn and Rogers - 2017 - Heterogeneous micro-structure of percolation in sp.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/TEW2FX5Q/1703.html}
}

@article{rogers2008a,
