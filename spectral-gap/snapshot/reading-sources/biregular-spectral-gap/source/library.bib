  issn = {1097-6256},
  doi = {10.1038/nn.2104},
  abstract = {Delineating neurons that underlie complex behaviors is of fundamental interest. Using adeno-associated virus 2, we expressed the Drosophila allatostatin receptor in somatostatin (Sst)-expressing neurons in the preB\"otzinger Complex (preB\"otC). Rapid silencing of these neurons in awake rats induced a persistent apnea without any respiratory movements to rescue their breathing. We hypothesize that breathing requires preB\"otC Sst neurons and that their sudden depression can lead to serious, even fatal, respiratory failure.},
