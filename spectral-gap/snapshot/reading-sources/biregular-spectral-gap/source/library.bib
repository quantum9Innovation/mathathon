  pages = {1096-1111},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/XHI6EJW7/Zingg et al. - 2014 - Neural Networks of the Mouse Neocortex.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/H94C44XZ/S0092867414002220.html}
}

