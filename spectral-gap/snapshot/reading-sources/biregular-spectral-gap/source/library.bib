@article{schottdorf2015,
  title = {Random {{Wiring}}, {{Ganglion Cell Mosaics}}, and the {{Functional Architecture}} of the {{Visual Cortex}}},
  volume = {11},
  doi = {10.1371/journal.pcbi.1004602},
  abstract = {Author Summary In the primary visual cortex of primates and carnivores, local visual stimulus features such as edge orientation are processed by neurons arranged in arrays of iso-orientation domains. Large-scale comparative studies have uncovered that the spatial layout of these domains and their topological defects follows species-invariant quantitative laws, predicted by models of large-scale circuit self-organization. Here, we ask whether the experimentally observed layout invariants might alternatively emerge as a consequence of random connectivity rules for feedforward projections from a small number of retinal cells to a much larger number of cortical target neurons. In this random wiring framework, the semi-regular and spatially granular arrangement of retinal ganglion cells determines the spatial layout of visual cortical iso-orientation domains\textemdash{}a hypothesis diametrically opposed to cortical large-scale circuit self-organization. Generalizing a prominent model of the early visual pathway, we find that the random wiring framework does not reproduce the experimentally determined layout invariants. Our results demonstrate how comparison between theory and quantitative phenomenological laws obtained from large-scale experimental data can successfully discriminate between competing hypotheses about the design principles of cortical circuits.},
  number = {11},
  journal = {PLoS Comput Biol},
  author = {Schottdorf, Manuel and Keil, Wolfgang and Coppola, David and White, Leonard E. and Wolf, Fred},
  month = nov,
  year = {2015},
  pages = {e1004602},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/RQNAF38W/Schottdorf et al. - 2015 - Random Wiring, Ganglion Cell Mosaics, and the Func.pdf}
}

@article{jenett2012,
  title = {A {{GAL4}}-{{Driver Line Resource}} for {{Drosophila Neurobiology}}},
  volume = {2},
  issn = {2211-1247},
  doi = {10.1016/j.celrep.2012.09.011},
  abstract = {Summary
We established a collection of 7,000 transgenic lines of Drosophila melanogaster. Expression of GAL4 in~each line is controlled by a different, defined fragment of genomic DNA that serves as a transcriptional enhancer. We used confocal microscopy of~dissected nervous systems to determine the expression patterns driven by each fragment in the adult brain and ventral nerve cord. We present image data on 6,650 lines. Using both manual and machine-assisted annotation, we describe the expression patterns in the most useful lines. We illustrate the utility of these data for identifying novel neuronal cell types, revealing brain asymmetry, and describing the nature and extent of neuronal shape stereotypy. The GAL4 lines allow expression of exogenous genes in distinct, small subsets of the adult nervous system. The set of DNA fragments, each driving a documented expression pattern, will facilitate the generation of additional constructs for manipulating neuronal function.},
  number = {4},
  journal = {Cell Reports},
  author = {Jenett, Arnim and Rubin, Gerald M. and Ngo, Teri-T. B. and Shepherd, David and Murphy, Christine and Dionne, Heather and Pfeiffer, Barret D. and Cavallaro, Amanda and Hall, Donald and Jeter, Jennifer and Iyer, Nirmala and Fetter, Dona and Hausenfluck, Joanna H. and Peng, Hanchuan and Trautman, Eric T. and Svirskas, Robert R. and Myers, Eugene W. and Iwinski, Zbigniew R. and Aso, Yoshinori and DePasquale, Gina M. and Enos, Adrianne and Hulamm, Phuson and Lam, Shing Chun Benny and Li, Hsing-Hsi and Laverty, Todd R. and Long, Fuhui and Qu, Lei and Murphy, Sean D. and Rokicki, Konrad and Safford, Todd and Shaw, Kshiti and Simpson, Julie H. and Sowell, Allison and Tae, Susana and Yu, Yang and Zugates, Christopher T.},
