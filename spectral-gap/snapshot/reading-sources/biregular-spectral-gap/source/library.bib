  month = jan,
  year = {2016},
  keywords = {Computational science,Computer science,Reward},
  pages = {484-489},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/PGKNRVEF/Silver et al. - 2016 - Mastering the game of Go with deep neural networks.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/U4NZRBGG/Silver et al. - 2016 - Mastering the game of Go with deep neural networks.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/RXF5WSSU/nature16961.html;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/VU87RAKZ/nature16961.html}
