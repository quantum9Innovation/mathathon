  keywords = {Error correction codes,Graph theory,Paper technology,Parity check codes,Signal to noise ratio,Tanner graph,associated adjacency matrix,binary codes,bipartite code constraint graph,bit nodes are,block codes,connectivity properties,eigenvalues,eigenvalues and eigenfunctions,graph analysis,iterative decoding,linear code,linear codes,linear programming,local connectivity,lower bound,matrix algebra,minimum-distance bounds,minimum-weight word,optimization problem,parity-check matrix,parity-check nodes,sparse block codes,sparse matrices,subgraph},
  pages = {808-821},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/TBSG2G8P/Tanner - 2001 - Minimum-distance bounds by graph analysis.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/XDMJM9A4/910591.html}
