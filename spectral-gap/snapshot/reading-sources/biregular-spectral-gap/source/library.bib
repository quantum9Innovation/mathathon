@article{massoulie2013,
  archivePrefix = {arXiv},
  eprinttype = {arxiv},
  eprint = {1311.3085},
  primaryClass = {cs},
  title = {Community Detection Thresholds and the Weak {{Ramanujan}} Property},
  abstract = {Decelle et al.$\backslash$cite\{Decelle11\} conjectured the existence of a sharp threshold for community detection in sparse random graphs drawn from the stochastic block model. Mossel et al.$\backslash$cite\{Mossel12\} established the negative part of the conjecture, proving impossibility of meaningful detection below the threshold. However the positive part of the conjecture remained elusive so far. Here we solve the positive part of the conjecture. We introduce a modified adjacency matrix \$B\$ that counts self-avoiding paths of a given length \$$\backslash$ell\$ between pairs of nodes and prove that for logarithmic \$$\backslash$ell\$, the leading eigenvectors of this modified matrix provide non-trivial detection, thereby settling the conjecture. A key step in the proof consists in establishing a \{$\backslash$em weak Ramanujan property\} of matrix \$B\$. Namely, the spectrum of \$B\$ consists in two leading eigenvalues \$$\backslash$rho(B)\$, \$$\backslash$lambda\_2\$ and \$n-2\$ eigenvalues of a lower order \$O(n\^\{$\backslash$epsilon\}$\backslash$sqrt\{$\backslash$rho(B)\})\$ for all \$$\backslash$epsilon$>$0\$, \$$\backslash$rho(B)\$ denoting \$B\$'s spectral radius. \$d\$-regular graphs are Ramanujan when their second eigenvalue verifies \$|$\backslash$lambda|$\backslash$le 2 $\backslash$sqrt\{d-1\}\$. Random \$d\$-regular graphs have a second largest eigenvalue \$$\backslash$lambda\$ of \$2$\backslash$sqrt\{d-1\}+o(1)\$ (see Friedman$\backslash$cite\{friedman08\}), thus being \{$\backslash$em almost\} Ramanujan. Erd$\backslash$H\{o\}s-R$\backslash$'enyi graphs with average degree \$d\$ at least logarithmic (\$d=$\backslash$Omega($\backslash$log n)\$) have a second eigenvalue of \$O($\backslash$sqrt\{d\})\$ (see Feige and Ofek$\backslash$cite\{Feige05\}), a slightly weaker version of the Ramanujan property. However this spectrum separation property fails for sparse (\$d=O(1)\$) Erd$\backslash$H\{o\}s-R$\backslash$'enyi graphs. Our result thus shows that by constructing matrix \$B\$ through neighborhood expansion, we regularize the original adjacency matrix to eventually recover a weak form of the Ramanujan property.},
  journal = {arXiv:1311.3085 [cs]},
  author = {Massoulie, Laurent},
  month = nov,
  year = {2013},
  keywords = {Computer Science - Social and Information Networks},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/9RW9NV6A/Massoulie - 2013 - Community detection thresholds and the weak Ramanu.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/8QNMH69H/1311.html}
}

@article{alon1986,
  title = {Eigenvalues and Expanders},
  volume = {6},
  issn = {0209-9683, 1439-6912},
  doi = {10.1007/BF02579166},
  abstract = {Linear expanders have numerous applications to theoretical computer science. Here we show that a regular bipartite graph is an expanderif and only if the second largest eigenvalue of its adjacency matrix is well separated from the first. This result, which has an analytic analogue for Riemannian manifolds enables one to generate expanders randomly and check efficiently their expanding properties. It also supplies an efficient algorithm for approximating the expanding properties of a graph. The exact determination of these properties is known to be coNP-complete.},
