  doi = {10.1006/jnth.1996.0109},
  abstract = {To a regular hypergraph we attach an operator, called its adjacency matrix, and study the second largest eigenvalue as well as the overall distribution of the spectrum of this operator. Our definition and results extend naturally what is known for graphs, including the analogous threshold bound[formula]fork-regular graphs. As an application of our results, we obtain asymptotic behavior, asNtends to infinity, of the dimension of the space generated by classical cusp forms of weight 2 levelNand trivial character which are eigenfunctions of a fixed Hecke operatorTpwith integral eigenvalues.},
