  abstract = {Surface-based atlases provide a valuable way to analyze and visualize the functional organization of cerebral cortex. Surfacebased registration (SBR) is a primary method for aligning individual hemispheres to a surface-based atlas. We used landmark-constrained SBR to register many published parcellation schemes to the macaque F99 surface-based atlas. This enables objective comparison of both similarities and differences across parcellations. Cortical areas in the macaque vary in surface area by more than 2 orders of magnitude. Based on a composite parcellation derived from 3 major sources, the total number of macaque neocortical and transitional cortical areas is estimated to be about 130--140 in each hemisphere.},
  language = {en},
  number = {10},
