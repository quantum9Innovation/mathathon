@article{kurschner2018,
  archivePrefix = {arXiv},
  eprinttype = {arxiv},
  eprint = {1808.05510},
  primaryClass = {math},
  title = {Greedy Low-Rank Algorithm for Spatial Connectome Regression},
  abstract = {We study a smooth matrix regression problem formulated to recover brain connectivity from data. The problem is set up as a general algebraic linear matrix equation of high dimension, and the desired solution is approximated by a low-rank factorization. This factorization is computed iteratively by an efficient greedy low-rank algorithm that exploits important properties of the original matrix equation, such as sparsity and positive definiteness. The performance of the method is evaluated on three test cases: a toy artificial dataset and two cortical problems employing data from the Allen Mouse Brain Connectivity Atlas. We find numerically that the method is significantly faster than previous gradient-based methods and converges to the full rank solution as the rank increases. This speedup allows for the estimation of increasingly large-scale connectomes as these data become available from tracing experiments.},
  journal = {arXiv:1808.05510 [math]},
  author = {K\"urschner, Patrick and Dolgov, Sergey and Harris, Kameron Decker and Benner, Peter},
  month = aug,
  year = {2018},
  keywords = {15A24; 15A83; 65F10 92C20; 94A08,Mathematics - Numerical Analysis},
