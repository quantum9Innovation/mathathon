@article{schweighofer2001,
  title = {Unsupervised Learning of Granule Cell Sparse Codes Enhances Cerebellar Adaptive Control},
  volume = {103},
  issn = {0306-4522},
  doi = {10.1016/S0306-4522(00)00548-0},
  abstract = {Marr [J. Physiol. (1969) 202, 437\textendash{}470] and Albus [Math. Biosci. (1971) 10, 25\textendash{}61] hypothesized that cerebellar learning is facilitated by a granule cell sparse code, i.e. a neural code in which the fraction of active neurons is low at any one time. In this paper, we re-examine this hypothesis in light of recent experimental and theoretical findings. We argue that cerebellar motor learning is enhanced by a sparse code that simultaneously maximizes information transfer between mossy fibers and granule cells, minimizes redundancies between granule cell discharges, and re-codes the mossy fiber inputs with an adaptive resolution such that inputs corresponding to large errors are finely encoded. We then propose that a set of biologically plausible unsupervised learning rules can produce such a code. To maintain a low mean firing rate compatible with a sparse code, an activity-dependent homeostatic mechanism sets the cells' thresholds. Then, to maximize information transfer, the mossy fiber\textendash{}granule cell synapses are adjusted by a Hebbian rule. Furthermore, to minimize redundancies between granule cell discharges, the inhibitory Golgi cell\textendash{}granule cell synapses are tuned by an anti-Hebbian rule. Finally, to allow adaptive resolution, a performance-based neuromodulator-like signal gates these three plastic processes. We integrate these gated learning rules into a simplified model of the cerebellum for arm movement control, and show that unsupervised learning of granule cell sparse codes greatly improves cerebellar adaptive motor control in comparison to a ``fixed'' Marr\textendash{}Albus-type model.

Until recently, activity-dependent cerebellar plasticity was thought to be largely confined to the granule cell\textendash{}Purkinje cell synapses. This static view of the cerebellum is, however, quickly being replaced by an extremely dynamic view in which plasticity is omnipresent. The present theoretical study shows how several forms of plasticity in the granular layer of the cerebellum can produce fast, accurate and stable cerebellar learning.},
  number = {1},
  journal = {Neuroscience},
  author = {Schweighofer, N. and Doya, K. and Lay, F.},
  month = feb,
  year = {2001},
  keywords = {Golgi cells,Hebbian learning,anti-Hebbian learning,cerebellum,granule cells,sparse code},
  pages = {35-50},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/SJ7X6542/Schweighofer et al. - 2001 - Unsupervised learning of granule cell sparse codes.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/SCQ8V6DA/S0306452200005480.html}
}

