\glossarysection[\glossarytoctitle]{\glossarytitle}\glossarypreamble
\begin{theglossary}\glossaryheader
\glsgroupheading{A}\relax \glsresetentrylist %
\glossaryentryfield{abstract partial trace}{\glsnamefont{abstract partial trace}}{a general setup to which we can apply side-stepping methods, which includes applications to $1/n$-asymptotic expansions arising in the certified trace}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{91}}}%
\glossaryentryfield{asymptotic expansion}{\glsnamefont{$1/n$-asymptotic expansion}}{an asymptotic expansion of a function $f(k,n)$ in powers of $1/n$ with coefficients being functions of $k$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{16}\delimN 
		\setentrycounter[]{page}\hyperit{29}\delimN 
		\setentrycounter[]{page}\glsnumberformat{32}\delimN 
		\setentrycounter[]{page}\glsnumberformat{37\delimN 38}\delimN 
		\setentrycounter[]{page}\glsnumberformat{41}\delimN 
		\setentrycounter[]{page}\glsnumberformat{51}\delimN 
		\setentrycounter[]{page}\glsnumberformat{105}}}%
\glossarysubentryfield{1}{B-Ramanujan-coef}{\glsnamefont{$B$-Ramanujan}}{a $1/n$-asymptotic expansion whose coefficients are $B$-Ramanujan functions}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{29}}}%
\glossarysubentryfield{1}{coefficient}{\glsnamefont{coefficient}}{a function of $k$ that appears as the coefficient of a $1/n$ power in a $1/n$-asymptotic expansion}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{29}\delimN 
		\setentrycounter[]{page}\glsnumberformat{37\delimN 38}\delimN 
		\setentrycounter[]{page}\glsnumberformat{41}\delimN 
		\setentrycounter[]{page}\glsnumberformat{105}}}\glsgroupskip
\glsgroupheading{B}\relax \glsresetentrylist %
\glossaryentryfield{B-eps-tangle}{\glsnamefont{$(B,\epsilon )$-tangle}}{a connected graph, $\psi \in \Occurs _B$, for which $\rho (H_\psi )\ge \epsilon +\rhoroot B$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{23}\delimN 
		\setentrycounter[]{page}\glsnumberformat{63}}}%
\glossaryentryfield{B-graph}{\glsnamefont{$B$-graph}}{a graph morphism to $B$, or, abusively, a graph with a given morphism to the graph $B$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{65}}}%
\glossarysubentryfield{1}{morphism of B-graphs}{\glsnamefont{morphism of $B$-graphs}}{a morphism of the sources that respects the $B$ structure of the $B$-graphs}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{65}}}%
\glossaryentryfield{B-Ramanujan function}{\glsnamefont{$B$-Ramanujan function}}{a function with a polyexponential part in the eigenvalues $\mu _i(B)$ and an error term}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{28}\delimN 
		\setentrycounter[]{page}\glsnumberformat{32}\delimN 
		\setentrycounter[]{page}\glsnumberformat{37\delimN 38}\delimN 
		\setentrycounter[]{page}\glsnumberformat{40}\delimN 
		\setentrycounter[]{page}\glsnumberformat{123}}}%
\glossarysubentryfield{1}{error term}{\glsnamefont{error term}}{the error term of a $B$-Ramanujan function}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{28}}}%
\glossarysubentryfield{1}{principle part}{\glsnamefont{principle part}}{the part of a $B$-Ramanujan function that is a polyexponential in the eigenvalues $\mu _i(B)$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{28}}}%
\glossaryentryfield{B-tangle}{\glsnamefont{$B$-tangle}}{a connected graph, $\psi \in \Occurs _B$, for which $\rho (H_\psi )\ge \rhoroot B$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{ix}\delimN 
		\setentrycounter[]{page}\hyperit{23}\delimN 
		\setentrycounter[]{page}\glsnumberformat{31}\delimN 
		\setentrycounter[]{page}\glsnumberformat{33}\delimN 
		\setentrycounter[]{page}\glsnumberformat{37}\delimN 
		\setentrycounter[]{page}\glsnumberformat{63}}}%
\glossaryentryfield{beaded path}{\glsnamefont{beaded path}}{a walk in a graph, each of whose interior vertices have degree two; especially used in the type (graph) of a walk, where one deletes all or all but one vertices of degree two, which breaks the deleted vertices into interior vertices of beaded paths}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{12}\delimN 
		\setentrycounter[]{page}\glsnumberformat{39}}}%
\glossaryentryfield{bouquet half}{\glsnamefont{bouquet of $d$ half-loops}}{the graph, $H_d$, which has one vertex and $d$ half-loops}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{8}}}%
\glossaryentryfield{bouquet whole}{\glsnamefont{bouquet of $d/2$ whole-loops}}{the graph, $W_{d/2}$, which has one vertex and $d/2$ whole-loops (with $d$ even)}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{8}\delimN 
		\setentrycounter[]{page}\glsnumberformat{24}}}%
\glossaryentryfield{Broder-Shamir model}{\glsnamefont{Broder-Shamir model}}{our standard model, $\cC _n(B)$, of a covering map of degree $n$ to a graph, $B$ }{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{3}\delimN 
		\setentrycounter[]{page}\hyperit{18}}}\glsgroupskip
\glsgroupheading{C}\relax \glsresetentrylist %
\glossaryentryfield{certified trace}{\glsnamefont{certified trace}}{the number of strictly non-backtracking closed walks, $w$, in a graph such that $\Graph (w)$ is of less than a given order and has its Hashimoto matrix spectral radius at most $\rhoroot B$ or, in Section~\ref {se:p2-fund-exp}, at most $\epsilon +\rhoroot B$ for a fixed value of $\epsilon >0$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{31}\delimN 
		\setentrycounter[]{page}\glsnumberformat{40}}}%
\glossaryentryfield{coefficient norm}{\glsnamefont{coefficient norm}}{the norm that takes a (real or complex) polynomial and returns the absolute value of its largest coefficient}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{45}}}%
\glossaryentryfield{coincidence}{\glsnamefont{coincidence}}{a value, $i$, for which the head of the $i$-th edge in a random walk was already visited in the walk, but the value of this $i$-th edge was not determined}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{27}\delimN 
		\setentrycounter[]{page}\glsnumberformat{57}}}%
\glossaryentryfield{convolution}{\glsnamefont{convolution}}{convolution in the additive sense, e.g., the sum of $g_1(k_1)g_2(k_2)$ with $k_1+k_2$ fixed}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{43}}}%
\glossarysubentryfield{1}{weighted convolution}{\glsnamefont{weighted convolution}}{weighted convolution in the additive sense, e.g., the sum of $g_1(k_1)g_2(k_2)$ with $m_1 k_1 + m_2 k_2$ fixed for fixed $m_1,m_2$ called the {\em weights}}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{47}}}%
\glossaryentryfield{covering map}{\glsnamefont{covering map}}{a morphism of graphs or directed graphs that is an isomorphism on heads neighbourhoods and tails neighbourhoods of each vertex in the domain with that of its image}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{3}\delimN 
		\setentrycounter[]{page}\hyperit{14}}}\glsgroupskip
\glsgroupheading{D}\relax \glsresetentrylist %
\glossaryentryfield{directed graph}{\glsnamefont{directed graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G)$ of a set of vertices, directed edges, and heads and tails maps}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{11}}}%
\glossarysubentryfield{1}{morphism of directed graphs}{\glsnamefont{morphism of directed graphs}}{a set theoretic map of vertices and edges from one graph to another that preserves the heads and tails relations}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{12}}}%
\glossaryentryfield{directed line graph}{\glsnamefont{directed line graph}}{the graph, $\Line (G)$, of a graph $G$ whose vertices are the directed edges of $G$, with an edge from $e_1$ to $e_2$ iff $h_G(e_1)=t_G(e_2)$ and $\iota _G(e_2)\ne \iota _G(e_1)$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{13}}}\glsgroupskip
\glsgroupheading{E}\relax \glsresetentrylist %
\glossaryentryfield{edge}{\glsnamefont{edge}}{{an orbit of the graph involution in a graph, i.e., a set of the form $\{e,\iota e\}$, where $e$ is a directed edge of the underlying directed graph and where $\iota $ is the opposite map} parent}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{11}}}%
\glossaryentryfield{etafund}{\glsnamefont{$\etafund (B)$}}{the order of the smallest strict tangle in $B$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{4}\delimN 
		\setentrycounter[]{page}\hyperit{68}}}%
\glossaryentryfield{etale map}{\glsnamefont{\'etale map}}{a morphism of graphs or directed graphs that is an injection on heads neighbourhoods and tails neighbourhoods of each vertex in the domain with that of its image}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{14}}}\glsgroupskip
\glsgroupheading{F}\relax \glsresetentrylist %
\glossaryentryfield{form}{\glsnamefont{form}}{the data of all the information about a $G\in \cC _n(B)$ that a potential walk determines; formally, it is a tuple $(F,\cE )$, where $F$ is a variable-length graph, and $\cE $ assigns to each edge of $F$ a walk in $B$; each potential walk has a unique form associated to it, and a forms are organized by their type}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{59}}}%
\glossaryentryfield{fundamental order}{\glsnamefont{fundamental order of $B$}}{the order of the smallest strict tangle in $B$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{68}\delimN 
		\setentrycounter[]{page}\glsnumberformat{117}}}\glsgroupskip
\glsgroupheading{G}\relax \glsresetentrylist %
\glossaryentryfield{graph}{\glsnamefont{graph}}{a tuple $G=(V_G,\Edir _G,h_G,t_G,\iota _G)$ where $(V_G,\Edir _G,h_G,t_G)$ is a directed graph (the {\em underlying directed graph}), and $\iota _G$ is a heads/tails reversing involution (sometimes called the {\em opposite map})}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{3}\delimN 
		\setentrycounter[]{page}\hyperit{11}}}%
\glossarysubentryfield{1}{directed edge}{\glsnamefont{directed edge}}{the edge set of a directed graph, or, for a graph, that of its underlying directed graph}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{11}}}%
\glossarysubentryfield{1}{involution}{\glsnamefont{involution}}{\nopostdesc }{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{11}}}%
\glossarysubentryfield{1}{morphism of graphs}{\glsnamefont{morphism of graphs}}{a morphism of underlying directed graphs that preserves the opposite map}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{12}}}%
\glossarysubentryfield{1}{opposite map}{\glsnamefont{opposite map}}{a heads/tail reversing involution that gives a directed graph the structure of a graph}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{11}}}%
\glossarysubentryfield{1}{orientation}{\glsnamefont{orientation}}{the choice of one representative directed edge for an edge of a graph}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{11\delimN 12}}}%
\glossarysubentryfield{1}{oriented graph}{\glsnamefont{oriented graph}}{a graph with an orientation for each of its edges}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{12}}}%
\glossarysubentryfield{1}{undirected edge}{\glsnamefont{undirected edge}}{\nopostdesc }{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{11}}}%
\glossaryentryfield{graph of a walk}{\glsnamefont{graph of a walk}}{the subgraph, $\Graph (w)$, traced out by a walk, $w$, in a graph}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{25}}}%
\glossaryentryfield{growth}{\glsnamefont{growth}}{describes a function of $k$ bounded by $Ck^C \rho ^k$ for some given $C$ and (more importantly) $\rho $}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{45}}}\glsgroupskip
\glsgroupheading{H}\relax \glsresetentrylist %
\glossaryentryfield{half-loop}{\glsnamefont{half-loop}}{an edge in a graph which is paired (via the graph involution) with itself}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{3}\delimN 
		\setentrycounter[]{page}\hyperit{11}}}%
\glossaryentryfield{Hashimoto matrix}{\glsnamefont{Hashimoto matrix}}{the adjacency matrix, $H_G$, of the directed line graph of $G$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{9}\delimN 
		\setentrycounter[]{page}\hyperit{13}}}\glsgroupskip
\glsgroupheading{L}\relax \glsresetentrylist %
\glossaryentryfield{loop}{\glsnamefont{loop}}{a strictly non-backtracking closed walk each of whose vertices have degree two}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{25}}}\glsgroupskip
\glsgroupheading{N}\relax \glsresetentrylist %
\glossaryentryfield{new function}{\glsnamefont{new function}}{a function on the vertices of a covering graph such that on all vertex fibres their sum is zero}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{16}}}%
\glossaryentryfield{new spectrum}{\glsnamefont{new spectrum}}{the part of the spectrum arising from new functions of a covering map}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{16}}}\glsgroupskip
\glsgroupheading{O}\relax \glsresetentrylist %
\glossaryentryfield{occurs-B}{\glsnamefont{$\Occurs _B$}}{a graph which is a subgraph of some element of $\cC _n(B)$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{23}}}%
\glossaryentryfield{old function}{\glsnamefont{old function}}{a function on the vertices of a covering graph such that on all vertex fibres they are constant}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{16}}}%
\glossaryentryfield{old spectrum}{\glsnamefont{old spectrum}}{the part of the spectrum arising from old functions of a covering map}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{16}}}%
\glossaryentryfield{omega-form}{\glsnamefont{$\Omega $-form}}{the analogue of a form for an $\Omega $-type; i.e., all the data in the graph determined by a potential walk plus a graph inclusion}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{86}}}%
\glossaryentryfield{omega-type}{\glsnamefont{$\Omega $-type}}{a structure that combines a potential graph specialization of a graph, $\Omega $, into a $G\in \cC _n(B)$, along with a potential walk, where we keep all of $\Omega $ in the $\Omega $-type but, as usual, discard those vertices of the potential walk of degree two that are interior vertices of the walk (not in $\Omega $)}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{86}}}%
\glossaryentryfield{order}{\glsnamefont{order}}{$\ord (G)=-\chi (G)$, minus the Euler characteristic of $G$, i.e., $|E_G|-|V_G|$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{23}\delimN 
		\setentrycounter[]{page}\glsnumberformat{31}\delimN 
		\setentrycounter[]{page}\glsnumberformat{33}\delimN 
		\setentrycounter[]{page}\glsnumberformat{37\delimN 38}\delimN 
		\setentrycounter[]{page}\glsnumberformat{41}}}%
\glossaryentryfield{oriented line graph}{\glsnamefont{oriented line graph}}{\nopostdesc }{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{13}}}\glsgroupskip
\glsgroupheading{P}\relax \glsresetentrylist %
\glossaryentryfield{permutation assignment}{\glsnamefont{permutation assignment}}{a map $\Edir _B\to \cS _n$, used in defining the Broder-Shamir model, $\cC _n(B)$, of a random covering of degree $n$ of a graph, $B$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{14}}}%
\glossaryentryfield{polyexponential}{\glsnamefont{polyexponential}}{a real or complex valued function on $\integers _{\ge 1}^m$ given by a sum of a product of polynomials in the variables times exponential functions in the variables}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{39}\delimN 
		\setentrycounter[]{page}\glsnumberformat{43}}}%
\glossaryentryfield{potential graph specialization}{\glsnamefont{potential graph specialization}}{an event in $\cC _n(B)$ which would give rise to the inclusion of a $B$-graph to a graph $G\in \cC _n(B)$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{79}}}%
\glossaryentryfield{potential walk}{\glsnamefont{potential walk}}{a pair $(w; \vec t\,)$, consisting of a walk, $w$, of length $k$ in the base graph, $B$, and a trajectory of values, $t$, which assigns to every vertex of $w$ an integer from $1$ to $n$ (for the model $\cC _n(B)$; intuitively a potential walk is a random event that give rise to a walk in the random graphs in $\cC _n(B)$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{52}}}%
\glossaryentryfield{pruned}{\glsnamefont{pruned}}{a graph each of whose vertices has degree at least two}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{41}}}\glsgroupskip
\glsgroupheading{R}\relax \glsresetentrylist %
\glossaryentryfield{Ramanujan graph}{\glsnamefont{Ramanujan graph}}{a $d$-regular graph, for some integer $d$, such that all its adjacency eigenvalues, aside from $d$ and possibly $-d$, are at most $2(d-1)^{1/2}$ }{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{3}}}\glsgroupskip
\glsgroupheading{S}\relax \glsresetentrylist %
\glossaryentryfield{self-loop}{\glsnamefont{self-loop}}{a directed edge or edge in a graph or directed graph whose head and tail are the same}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{3}\delimN 
		\setentrycounter[]{page}\hyperit{11}}}%
\glossaryentryfield{shift operator in k}{\glsnamefont{shift operator in $k$}}{the operator taking $f(n,k)$ and returning $f(n,k+1)$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{89}}}%
\glossaryentryfield{subgraphs occurring in a B covering}{\glsnamefont{subgraphs occurring in a $B$ covering}}{the subgraphs occurring in $\cC _n(B)$ for some $n$, where $\cC _n(B)$ is the Broder-Shamir model or a related model}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{23}}}\glsgroupskip
\glsgroupheading{T}\relax \glsresetentrylist %
\glossaryentryfield{tangle of B}{\glsnamefont{tangle of $B$}}{a graph, $\psi \in \Occurs _B$ for which $\rho (H_\psi )\ge \rhoroot B$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{23}}}%
\glossarysubentryfield{1}{strict tangle of B}{\glsnamefont{strict tangle of $B$}}{a graph, $\psi $, in $\Occurs _B$ for which $\rho (H_\psi )> \rhoroot B$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{23}\delimN 
		\setentrycounter[]{page}\glsnumberformat{63}\delimN 
		\setentrycounter[]{page}\glsnumberformat{68}\delimN 
		\setentrycounter[]{page}\glsnumberformat{117}}}%
\glossaryentryfield{tree}{\glsnamefont{tree}}{a connected graph of Euler characteristic $-1$, i.e., a tree in the usual sense, which includes the case of a graph with one vertex and no edges}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{41}}}%
\glossarysubentryfield{1}{treeless}{\glsnamefont{treeless}}{a graph with no connected components that are trees}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{41}}}%
\glossaryentryfield{type}{\glsnamefont{type}}{the data associated to any closed walk in a graph which remembers the following information: the initial vertex, the vertices of length at least three, the (beaded) paths of the walk between such vertices (yielding a graph called the {\em type graph} of the walk, which is an oriented graph by orienting the edges by the direction in which they are first traversed; the order in which each of these vertices and paths are first encountered; and the $B$-neighbourhood of each vertex (the {\em lettering}). Alternatively, it is this data (an oriented graph, orderings of vertices and edges, and $B$-neighbourhood) as abstract data (not associated to a particular walk)}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{x}\delimN 
		\setentrycounter[]{page}\glsnumberformat{31}\delimN 
		\setentrycounter[]{page}\hyperit{39}\delimN 
		\setentrycounter[]{page}\hyperit{58}}}\glsgroupskip
\glsgroupheading{U}\relax \glsresetentrylist %
\glossaryentryfield{undirected graph}{\glsnamefont{undirected graph}}{\nopostdesc }{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{11}}}\glsgroupskip
\glsgroupheading{V}\relax \glsresetentrylist %
\glossaryentryfield{variable-length graph}{\glsnamefont{variable-length graph}}{a graph or directed graph whose edges or directed edges each have an associated length}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{17}}}%
\glossarysubentryfield{1}{realization of a variable-length graph}{\glsnamefont{realization of a variable-length graph}}{the graph, $\VLG (G,\vec k)$, by taking a directed or undirected variable-length graph and replacing each edge, $e$, by a path of length $k(e)$}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{17}}}\glsgroupskip
\glsgroupheading{W}\relax \glsresetentrylist %
\glossaryentryfield{walk}{\glsnamefont{walk}}{an alternating sequence of vertices and directed edges that ``follow in sequence,'' in a graph or directed graph}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{12}}}%
\glossarysubentryfield{1}{closed}{\glsnamefont{closed}}{a walk whose first vertex equals its last}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{12}}}%
\glossarysubentryfield{1}{interior vertex}{\glsnamefont{interior vertex}}{a vertex in a walk which is not the first or last vertex}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{12}}}%
\glossarysubentryfield{1}{non-backtracking}{\glsnamefont{non-backtracking}}{a walk where any two consecutive edges are not opposites}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{12}\delimN 
		\setentrycounter[]{page}\glsnumberformat{39}}}%
\glossarysubentryfield{1}{reverse walk}{\glsnamefont{reverse walk}}{the reverse walk of a walk, $w$, in a graph is the walk where the order of the vertices and edges are reversed, and each edge is replaced by its opposite}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{12}\delimN 
		\setentrycounter[]{page}\glsnumberformat{59}}}%
\glossarysubentryfield{1}{strictly non-backtracking closed}{\glsnamefont{strictly non-backtracking closed}}{a closed, non-backtracking walk whose first and last edges are not opposites}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\hyperit{12}}}%
\glossaryentryfield{walk sum}{\glsnamefont{walk sum}}{a sum of expected values of walks, $w$, in graphs subject to certain restrictions on $\Graph (w)$, the length of $w$, and the manner in which $w$ traces out $\Graph (w)$ in its sequence of vertices and edges}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{39\delimN 40}}}%
\glossaryentryfield{whole-loop}{\glsnamefont{whole-loop}}{an edge in a graph which is paired (via the graph involution) with a different edge}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{3}\delimN 
		\setentrycounter[]{page}\hyperit{11}}}%
\end{theglossary}\glossarypostamble
