  doi = {10.1046/j.1460-9568.1999.00826.x},
  abstract = {Odours are represented by specific ensembles of activated glomeruli in a combinatorial manner within the olfactory bulb of vertebrates or the antennal lobe (AL) of insects. Here, we optically measured glomerular calcium activities in vivo in the honeybee Apis mellifera during olfactory stimulation with 36 pure chemicals differing systematically in carbon chain length (C-5\textendash{}10) and functional group (aldehyde, ketone, alcohol, carboxylic acid and alkane). We show their glomerular representations in 38 morphologically identified glomeruli out of the honeybee's 160. We measured the molecular receptive range of identified glomeruli averaging up to 21 individuals. Of the 38 glomeruli measured, 23 show maximal activity in a specific range of chain length. Glomeruli preferentially responding to a functional group are also always broadly tuned to particular chain lengths. Furthermore, glomeruli with similar response spectra are often direct neighbours. The results allow conclusions about the interactions between olfactory receptors and odour molecules, and about the AL network.},
  language = {en},
  number = {11},
  journal = {European Journal of Neuroscience},
  author = {Sachse, Silke and Rappert, Angelika and Galizia, C. Giovanni},
  month = nov,
  year = {1999},
  keywords = {Apis mellifera,hydrocarbons,molecular receptive range,olfactory glomeruli,optical recording},
  pages = {3970-3982},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/XJBFHNKT/Sachse et al. - 1999 - The spatial representation of chemical structures .pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/BRHC4ZTB/abstract\;jsessionid=474D9689C80E6F5A234240B649735057.html}
}

