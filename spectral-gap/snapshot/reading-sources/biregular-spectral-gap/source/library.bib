}

@article{hopke1998,
  title = {Three-Way ({{PARAFAC}}) Factor Analysis: Examination and Comparison of Alternative Computational Methods as Applied to Ill-Conditioned Data},
  volume = {43},
  issn = {0169-7439},
  shorttitle = {Three-Way ({{PARAFAC}}) Factor Analysis},
  doi = {10.1016/S0169-7439(98)00077-X},
  abstract = {Four different approaches to solving the trilinear three-way factor analysis problem are compared, and their performance with ‘difficult' (i.e., ill-conditioned) data is tested. These approaches are represented by four different computer programs: one using a simple alternating least squares (ALS) algorithm with only minimal extrapolation (HL-PARAFAC), one in which the ALS is supplemented by a sophisticated extrapolation to speed convergence (TPALS), one using a non-linear curve fitting method (PMF3), and one using a non-iterative closed-form approximation (DTDMR). The options provided by these programs (e.g., with regard to missing values, weighted least squares, non-negativity and other constraints) are compared. Criteria for choosing synthesized test data and a method for synthesizing exponential test data are described. A numerical index is introduced to characterize the ill-conditioning of n-way arrays (n$>$2). Two well characterized synthetic data sets serve as ‘difficult' (ill-conditioned) test data. Intercomparisons among HL-PARAFAC, TPALS, DTDMR and PMF3 were implemented with these test data. Consequently, their limitations and strengths are determined. In addition, these trilinear analysis approaches are applied to a difficult set of ill-conditioned real data: a set of fluorescence spectroscopy measurements that characterize the steady-state fluorescence of an amino acid in aqueous solution. When converged, the results produced by the three least-squares techniques (but not DTDMR) agree. However, there are large differences in convergence speed when these difficult problems are solved: TPALS is faster than PARAFAC by a factor of ten, and PMF3 is faster than TPALS, again by a factor of ten. The program DTDMR is the fastest, but it only solves half of the problems.},
  number = {1},
  journal = {Chemometrics and Intelligent Laboratory Systems},
  author = {Hopke, Philip K. and Paatero, Pentti and Jia, Hong and Ross, Robert T. and Harshman, Richard A.},
  month = sep,
  year = {1998},
  keywords = {PARAFAC,DTDMR,Factor analysis,Fluorescence spectroscopy,PMF3,TPALS,Trilinear},
  pages = {25-42},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/XWQ4EPE3/Hopke et al. - 1998 - Three-way (PARAFAC) factor analysis examination a.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/SHLFJNV9/S016974399800077X.html}
}

@article{bourely2017,
  archivePrefix = {arXiv},
  eprinttype = {arxiv},
  eprint = {1706.05683},
  primaryClass = {cs, stat},
  title = {Sparse {{Neural Networks Topologies}}},
  abstract = {We propose Sparse Neural Network architectures that are based on random or structured bipartite graph topologies. Sparse architectures provide compression of the models learned and speed-ups of computations, they can also surpass their unstructured or fully connected counterparts. As we show, even more compact topologies of the so-called SNN (Sparse Neural Network) can be achieved with the use of structured graphs of connections between consecutive layers of neurons. In this paper, we investigate how the accuracy and training speed of the models depend on the topology and sparsity of the neural network. Previous approaches using sparcity are all based on fully connected neural network models and create sparcity during training phase, instead we explicitly define a sparse architectures of connections before the training. Building compact neural network models is coherent with empirical observations showing that there is much redundancy in learned neural network models. We show experimentally that the accuracy of the models learned with neural networks depends on expander-like properties of the underlying topologies such as the spectral gap and algebraic connectivity rather than the density of the graphs of connections.},
  journal = {arXiv:1706.05683 [cs, stat]},
  author = {Bourely, Alfred and Boueri, John Patrick and Choromonski, Krzysztof},
  month = jun,
  year = {2017},
  keywords = {Computer Science - Learning,Statistics - Machine Learning,Computer Science - Neural and Evolutionary Computing},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/TUEAIM3G/Bourely et al. - 2017 - Sparse Neural Networks Topologies.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/T56FC6QH/1706.html}
}

@article{prabhu2017,
  archivePrefix = {arXiv},
  eprinttype = {arxiv},
  eprint = {1711.08757},
  primaryClass = {cs},
  title = {Deep {{Expander Networks}}: {{Efficient Deep Networks}} from {{Graph Theory}}},
  shorttitle = {Deep {{Expander Networks}}},
  abstract = {Deep Neural Networks, while being unreasonably effective for several vision tasks, have their usage limited by the computational and memory requirements, both during training and inference stages. Analyzing and improving the connectivity patterns between layers of a network has resulted in several compact architectures like GoogleNet, ResNet and DenseNet-BC. In this work, we utilize results from graph theory to develop an efficient connection pattern between consecutive layers. Specifically, we use \{$\backslash$it expander graphs\} that have excellent connectivity properties to develop a sparse network architecture, the deep expander network (X-Net). The X-Nets are shown to have high connectivity for a given level of sparsity. We also develop highly efficient training and inference algorithms for such networks. Experimental results show that we can achieve the similar or better accuracy as DenseNet-BC with two-thirds the number of parameters and FLOPs on several image classification benchmarks. We hope that this work motivates other approaches to utilize results from graph theory to develop efficient network architectures.},
  journal = {arXiv:1711.08757 [cs]},
  author = {Prabhu, Ameya and Varma, Girish and Namboodiri, Anoop},
  month = nov,
  year = {2017},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/HWLVP4D6/Prabhu et al. - 2017 - Deep Expander Networks Efficient Deep Networks fr.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/736HZX4G/1711.html}
}

@inproceedings{kumar2011,
  title = {Exponential Pattern Retrieval Capacity with Non-Binary Associative Memory},
  doi = {10.1109/ITW.2011.6089532},
  abstract = {We consider the problem of neural association for a network of non-binary neurons. Here, the task is to recall a previously memorized pattern from its noisy version using a network of neurons whose states assume values from a finite number of non-negative integer levels. Prior works in this area consider storing a finite number of purely random patterns, and have shown that the pattern retrieval capacities (maximum number of patterns that can be memorized) scale only linearly with the number of neurons in the network. In our formulation of the problem, we consider storing patterns from a suitably chosen set of patterns, that are obtained by enforcing a set of simple constraints on the coordinates (such as those enforced in graph based codes). Such patterns may be generated from purely random information symbols by simple neural operations. Two simple neural update algorithms are presented, and it is shown that our proposed mechanisms result in a pattern retrieval capacity that is exponential in terms of the network size. Furthermore, using analytical results and simulations, we show that the suggested methods can tolerate a fair amount of errors in the input.},
  booktitle = {2011 {{IEEE Information Theory Workshop}}},
  author = {Kumar, K. R. and Salavati, A. H. and Shokrollahi, A.},
  month = oct,
  year = {2011},
  keywords = {Graph theory,Neurons,Noise,Vectors,Associative memory,Biological neural networks,content-addressable storage,exponential pattern retrieval capacity,Information theory,memorized pattern,network size,neural association,neural nets,neural update algorithms,non-binary associative memory,non-binary neurons,non-negative integer levels},
  pages = {80-84},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/VKY7R2MM/Kumar et al. - 2011 - Exponential pattern retrieval capacity with non-bi.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/4TMDTLXR/6089532.html}
}

@article{vanessen2012a,
