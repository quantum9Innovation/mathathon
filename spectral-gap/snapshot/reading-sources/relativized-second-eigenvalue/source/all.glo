\glossaryentry{B-Ramanujan function?\glossaryentryfield{B-Ramanujan function}{\glsnamefont{$B$-Ramanujan function}}{a function with a polyexponential part in the eigenvalues $\mu _i(B)$ and an error term}{\relax }|setentrycounter[]{page}\glsnumberformat}{38}
\glossaryentry{order?\glossaryentryfield{order}{\glsnamefont{order}}{$\ord (G)=-\chi (G)$, minus the Euler characteristic of $G$, i.e., $"|E_G"|-"|V_G"|$}{\relax }|setentrycounter[]{page}\glsnumberformat}{38}
\glossaryentry{type?\glossaryentryfield{type}{\glsnamefont{type}}{the data associated to any closed walk in a graph which remembers the following information: the initial vertex, the vertices of length at least three, the (beaded) paths of the walk between such vertices (yielding a graph called the {\em type graph} of the walk, which is an oriented graph by orienting the edges by the direction in which they are first traversed; the order in which each of these vertices and paths are first encountered; and the $B$-neighbourhood of each vertex (the {\em lettering}). Alternatively, it is this data (an oriented graph, orderings of vertices and edges, and $B$-neighbourhood) as abstract data (not associated to a particular walk)}{\relax }!type graph?\glossarysubentryfield{1}{type graph}{\glsnamefont{type graph}}{The part of a type consisting only of the underlying oriented graph of the type (without the ordering and $B$-neighbourhood date); the type graph of a walk, $w$, is denoted $\TypeGraph (w)$}{\relax }|setentrycounter[]{page}\glsnumberformat}{39}
\glossaryentry{beaded path?\glossaryentryfield{beaded path}{\glsnamefont{beaded path}}{a walk in a graph, each of whose interior vertices have degree two; especially used in the type (graph) of a walk, where one deletes all or all but one vertices of degree two, which breaks the deleted vertices into interior vertices of beaded paths}{\relax }|setentrycounter[]{page}\glsnumberformat}{39}
\glossaryentry{type?\glossaryentryfield{type}{\glsnamefont{type}}{the data associated to any closed walk in a graph which remembers the following information: the initial vertex, the vertices of length at least three, the (beaded) paths of the walk between such vertices (yielding a graph called the {\em type graph} of the walk, which is an oriented graph by orienting the edges by the direction in which they are first traversed; the order in which each of these vertices and paths are first encountered; and the $B$-neighbourhood of each vertex (the {\em lettering}). Alternatively, it is this data (an oriented graph, orderings of vertices and edges, and $B$-neighbourhood) as abstract data (not associated to a particular walk)}{\relax }|setentrycounter[]{page}\hyperit}{39}
\glossaryentry{walk sum?\glossaryentryfield{walk sum}{\glsnamefont{walk sum}}{a sum of expected values of walks, $w$, in graphs subject to certain restrictions on $\Graph (w)$, the length of $w$, and the manner in which $w$ traces out $\Graph (w)$ in its sequence of vertices and edges}{\relax }|setentrycounter[]{page}\glsnumberformat}{39}
\glossaryentry{walk?\glossaryentryfield{walk}{\glsnamefont{walk}}{an alternating sequence of vertices and directed edges that ``follow in sequence,'' in a graph or directed graph}{\relax }!non-backtracking?\glossarysubentryfield{1}{non-backtracking}{\glsnamefont{non-backtracking}}{a walk where any two consecutive edges are not opposites}{\relax }|setentrycounter[]{page}\glsnumberformat}{39}
\glossaryentry{beaded path?\glossaryentryfield{beaded path}{\glsnamefont{beaded path}}{a walk in a graph, each of whose interior vertices have degree two; especially used in the type (graph) of a walk, where one deletes all or all but one vertices of degree two, which breaks the deleted vertices into interior vertices of beaded paths}{\relax }|setentrycounter[]{page}\glsnumberformat}{39}
\glossaryentry{polyexponential?\glossaryentryfield{polyexponential}{\glsnamefont{polyexponential}}{a real or complex valued function on $\integers _{\ge 1}^m$ given by a sum of a product of polynomials in the variables times exponential functions in the variables}{\relax }|setentrycounter[]{page}\hyperit}{39}
\glossaryentry{B-Ramanujan function?\glossaryentryfield{B-Ramanujan function}{\glsnamefont{$B$-Ramanujan function}}{a function with a polyexponential part in the eigenvalues $\mu _i(B)$ and an error term}{\relax }|setentrycounter[]{page}\glsnumberformat}{40}
\glossaryentry{B-Ramanujan function?\glossaryentryfield{B-Ramanujan function}{\glsnamefont{$B$-Ramanujan function}}{a function with a polyexponential part in the eigenvalues $\mu _i(B)$ and an error term}{\relax }|setentrycounter[]{page}\glsnumberformat}{40}
\glossaryentry{walk sum?\glossaryentryfield{walk sum}{\glsnamefont{walk sum}}{a sum of expected values of walks, $w$, in graphs subject to certain restrictions on $\Graph (w)$, the length of $w$, and the manner in which $w$ traces out $\Graph (w)$ in its sequence of vertices and edges}{\relax }|setentrycounter[]{page}\glsnumberformat}{40}
\glossaryentry{certified trace?\glossaryentryfield{certified trace}{\glsnamefont{certified trace}}{the number of strictly non-backtracking closed walks, $w$, in a graph such that $\Graph (w)$ is of less than a given order and has its Hashimoto matrix spectral radius at most $\rhoroot B$ or, in Section~\ref {se:p2-fund-exp}, at most $\epsilon +\rhoroot B$ for a fixed value of $\epsilon >0$}{\relax }|setentrycounter[]{page}\glsnumberformat}{40}
\glossaryentry{asymptotic expansion?\glossaryentryfield{asymptotic expansion}{\glsnamefont{$1/n$-asymptotic expansion}}{an asymptotic expansion of a function $f(k,n)$ in powers of $1/n$ with coefficients being functions of $k$}{\relax }!coefficient?\glossarysubentryfield{1}{coefficient}{\glsnamefont{coefficient}}{a function of $k$ that appears as the coefficient of a $1/n$ power in a $1/n$-asymptotic expansion}{\relax }|setentrycounter[]{page}\glsnumberformat}{41}
\glossaryentry{asymptotic expansion?\glossaryentryfield{asymptotic expansion}{\glsnamefont{$1/n$-asymptotic expansion}}{an asymptotic expansion of a function $f(k,n)$ in powers of $1/n$ with coefficients being functions of $k$}{\relax }|setentrycounter[]{page}\glsnumberformat}{41}
\glossaryentry{order?\glossaryentryfield{order}{\glsnamefont{order}}{$\ord (G)=-\chi (G)$, minus the Euler characteristic of $G$, i.e., $"|E_G"|-"|V_G"|$}{\relax }|setentrycounter[]{page}\glsnumberformat}{41}
\glossaryentry{tree?\glossaryentryfield{tree}{\glsnamefont{tree}}{a connected graph of Euler characteristic $-1$, i.e., a tree in the usual sense, which includes the case of a graph with one vertex and no edges}{\relax }|setentrycounter[]{page}\hyperit}{41}
\glossaryentry{tree?\glossaryentryfield{tree}{\glsnamefont{tree}}{a connected graph of Euler characteristic $-1$, i.e., a tree in the usual sense, which includes the case of a graph with one vertex and no edges}{\relax }!treeless?\glossarysubentryfield{1}{treeless}{\glsnamefont{treeless}}{a graph with no connected components that are trees}{\relax }|setentrycounter[]{page}\hyperit}{41}
\glossaryentry{pruned?\glossaryentryfield{pruned}{\glsnamefont{pruned}}{a graph each of whose vertices has degree at least two}{\relax }|setentrycounter[]{page}\hyperit}{41}
\glossaryentry{convolution?\glossaryentryfield{convolution}{\glsnamefont{convolution}}{convolution in the additive sense, e.g., the sum of $g_1(k_1)g_2(k_2)$ with $k_1+k_2$ fixed}{\relax }|setentrycounter[]{page}\hyperit}{43}
\glossaryentry{polyexponential?\glossaryentryfield{polyexponential}{\glsnamefont{polyexponential}}{a real or complex valued function on $\integers _{\ge 1}^m$ given by a sum of a product of polynomials in the variables times exponential functions in the variables}{\relax }|setentrycounter[]{page}\glsnumberformat}{43}
\glossaryentry{growth?\glossaryentryfield{growth}{\glsnamefont{growth}}{describes a function of $k$ bounded by $Ck^C \rho ^k$ for some given $C$ and (more importantly) $\rho $}{\relax }|setentrycounter[]{page}\hyperit}{45}
\glossaryentry{coefficient norm?\glossaryentryfield{coefficient norm}{\glsnamefont{coefficient norm}}{the norm that takes a (real or complex) polynomial and returns the absolute value of its largest coefficient}{\relax }|setentrycounter[]{page}\hyperit}{45}
\glossaryentry{convolution?\glossaryentryfield{convolution}{\glsnamefont{convolution}}{convolution in the additive sense, e.g., the sum of $g_1(k_1)g_2(k_2)$ with $k_1+k_2$ fixed}{\relax }!weighted convolution?\glossarysubentryfield{1}{weighted convolution}{\glsnamefont{weighted convolution}}{weighted convolution in the additive sense, e.g., the sum of $g_1(k_1)g_2(k_2)$ with $m_1 k_1 + m_2 k_2$ fixed for fixed $m_1,m_2$ called the {\em weights}}{\relax }|setentrycounter[]{page}\hyperit}{47}
\glossaryentry{asymptotic expansion?\glossaryentryfield{asymptotic expansion}{\glsnamefont{$1/n$-asymptotic expansion}}{an asymptotic expansion of a function $f(k,n)$ in powers of $1/n$ with coefficients being functions of $k$}{\relax }|setentrycounter[]{page}\glsnumberformat}{51}
\glossaryentry{potential walk?\glossaryentryfield{potential walk}{\glsnamefont{potential walk}}{a pair $(w; \vec t\,)$, consisting of a walk, $w$, of length $k$ in the base graph, $B$, and a trajectory of values, $t$, which assigns to every vertex of $w$ an integer from $1$ to $n$ (for the model $\cC _n(B)$; intuitively a potential walk is a random event that give rise to a walk in the random graphs in $\cC _n(B)$}{\relax }|setentrycounter[]{page}\hyperit}{52}
\glossaryentry{coincidence?\glossaryentryfield{coincidence}{\glsnamefont{coincidence}}{a value, $i$, for which the head of the $i$-th edge in a random walk was already visited in the walk, but the value of this $i$-th edge was not determined}{\relax }|setentrycounter[]{page}\glsnumberformat}{57}
\glossaryentry{type?\glossaryentryfield{type}{\glsnamefont{type}}{the data associated to any closed walk in a graph which remembers the following information: the initial vertex, the vertices of length at least three, the (beaded) paths of the walk between such vertices (yielding a graph called the {\em type graph} of the walk, which is an oriented graph by orienting the edges by the direction in which they are first traversed; the order in which each of these vertices and paths are first encountered; and the $B$-neighbourhood of each vertex (the {\em lettering}). Alternatively, it is this data (an oriented graph, orderings of vertices and edges, and $B$-neighbourhood) as abstract data (not associated to a particular walk)}{\relax }|setentrycounter[]{page}\hyperit}{58}
\glossaryentry{type?\glossaryentryfield{type}{\glsnamefont{type}}{the data associated to any closed walk in a graph which remembers the following information: the initial vertex, the vertices of length at least three, the (beaded) paths of the walk between such vertices (yielding a graph called the {\em type graph} of the walk, which is an oriented graph by orienting the edges by the direction in which they are first traversed; the order in which each of these vertices and paths are first encountered; and the $B$-neighbourhood of each vertex (the {\em lettering}). Alternatively, it is this data (an oriented graph, orderings of vertices and edges, and $B$-neighbourhood) as abstract data (not associated to a particular walk)}{\relax }!type graph?\glossarysubentryfield{1}{type graph}{\glsnamefont{type graph}}{The part of a type consisting only of the underlying oriented graph of the type (without the ordering and $B$-neighbourhood date); the type graph of a walk, $w$, is denoted $\TypeGraph (w)$}{\relax }|setentrycounter[]{page}\glsnumberformat}{58}
\glossaryentry{form?\glossaryentryfield{form}{\glsnamefont{form}}{the data of all the information about a $G\in \cC _n(B)$ that a potential walk determines; formally, it is a tuple $(F,\cE )$, where $F$ is a variable-length graph, and $\cE $ assigns to each edge of $F$ a walk in $B$; each potential walk has a unique form associated to it, and a forms are organized by their type}{\relax }|setentrycounter[]{page}\hyperit}{59}
\glossaryentry{walk?\glossaryentryfield{walk}{\glsnamefont{walk}}{an alternating sequence of vertices and directed edges that ``follow in sequence,'' in a graph or directed graph}{\relax }!reverse walk?\glossarysubentryfield{1}{reverse walk}{\glsnamefont{reverse walk}}{the reverse walk of a walk, $w$, in a graph is the walk where the order of the vertices and edges are reversed, and each edge is replaced by its opposite}{\relax }|setentrycounter[]{page}\glsnumberformat}{59}
\glossaryentry{B-tangle?\glossaryentryfield{B-tangle}{\glsnamefont{$B$-tangle}}{a connected graph, $\psi \in \Occurs _B$, for which $\rho (H_\psi )\ge \rhoroot B$}{\relax }|setentrycounter[]{page}\glsnumberformat}{63}
\glossaryentry{tangle of B?\glossaryentryfield{tangle of B}{\glsnamefont{tangle of $B$}}{a graph, $\psi \in \Occurs _B$ for which $\rho (H_\psi )\ge \rhoroot B$}{\relax }!strict tangle of B?\glossarysubentryfield{1}{strict tangle of B}{\glsnamefont{strict tangle of $B$}}{a graph, $\psi $, in $\Occurs _B$ for which $\rho (H_\psi )> \rhoroot B$}{\relax }|setentrycounter[]{page}\glsnumberformat}{63}
\glossaryentry{B-tangle?\glossaryentryfield{B-tangle}{\glsnamefont{$B$-tangle}}{a connected graph, $\psi \in \Occurs _B$, for which $\rho (H_\psi )\ge \rhoroot B$}{\relax }|setentrycounter[]{page}\glsnumberformat}{63}
\glossaryentry{B-eps-tangle?\glossaryentryfield{B-eps-tangle}{\glsnamefont{$(B,\epsilon )$-tangle}}{a connected graph, $\psi \in \Occurs _B$, for which $\rho (H_\psi )\ge \epsilon +\rhoroot B$}{\relax }|setentrycounter[]{page}\glsnumberformat}{63}
\glossaryentry{B-graph?\glossaryentryfield{B-graph}{\glsnamefont{$B$-graph}}{a graph morphism to $B$, or, abusively, a graph with a given morphism to the graph $B$}{\relax }|setentrycounter[]{page}\hyperit}{65}
\glossaryentry{B-graph?\glossaryentryfield{B-graph}{\glsnamefont{$B$-graph}}{a graph morphism to $B$, or, abusively, a graph with a given morphism to the graph $B$}{\relax }!morphism of B-graphs?\glossarysubentryfield{1}{morphism of B-graphs}{\glsnamefont{morphism of $B$-graphs}}{a morphism of the sources that respects the $B$ structure of the $B$-graphs}{\relax }|setentrycounter[]{page}\glsnumberformat}{65}
\glossaryentry{fundamental order?\glossaryentryfield{fundamental order}{\glsnamefont{fundamental order of $B$}}{the order of the smallest strict tangle in $B$}{\relax }|setentrycounter[]{page}\hyperit}{68}
\glossaryentry{etafund?\glossaryentryfield{etafund}{\glsnamefont{$\etafund (B)$}}{the order of the smallest strict tangle in $B$}{\relax }|setentrycounter[]{page}\hyperit}{68}
\glossaryentry{tangle of B?\glossaryentryfield{tangle of B}{\glsnamefont{tangle of $B$}}{a graph, $\psi \in \Occurs _B$ for which $\rho (H_\psi )\ge \rhoroot B$}{\relax }!strict tangle of B?\glossarysubentryfield{1}{strict tangle of B}{\glsnamefont{strict tangle of $B$}}{a graph, $\psi $, in $\Occurs _B$ for which $\rho (H_\psi )> \rhoroot B$}{\relax }|setentrycounter[]{page}\glsnumberformat}{68}
\glossaryentry{potential graph specialization?\glossaryentryfield{potential graph specialization}{\glsnamefont{potential graph specialization}}{an event in $\cC _n(B)$ which would give rise to the inclusion of a $B$-graph to a graph $G\in \cC _n(B)$}{\relax }|setentrycounter[]{page}\hyperit}{79}
\glossaryentry{omega-type?\glossaryentryfield{omega-type}{\glsnamefont{$\Omega $-type}}{a structure that combines a potential graph specialization of a graph, $\Omega $, into a $G\in \cC _n(B)$, along with a potential walk, where we keep all of $\Omega $ in the $\Omega $-type but, as usual, discard those vertices of the potential walk of degree two that are interior vertices of the walk (not in $\Omega $)}{\relax }|setentrycounter[]{page}\hyperit}{86}
\glossaryentry{omega-form?\glossaryentryfield{omega-form}{\glsnamefont{$\Omega $-form}}{the analogue of a form for an $\Omega $-type; i.e., all the data in the graph determined by a potential walk plus a graph inclusion}{\relax }|setentrycounter[]{page}\hyperit}{86}
\glossaryentry{shift operator in k?\glossaryentryfield{shift operator in k}{\glsnamefont{shift operator in $k$}}{the operator taking $f(n,k)$ and returning $f(n,k+1)$}{\relax }|setentrycounter[]{page}\hyperit}{89}
\glossaryentry{abstract partial trace?\glossaryentryfield{abstract partial trace}{\glsnamefont{abstract partial trace}}{a general setup to which we can apply side-stepping methods, which includes applications to $1/n$-asymptotic expansions arising in the certified trace}{\relax }|setentrycounter[]{page}\hyperit}{91}
\glossaryentry{asymptotic expansion?\glossaryentryfield{asymptotic expansion}{\glsnamefont{$1/n$-asymptotic expansion}}{an asymptotic expansion of a function $f(k,n)$ in powers of $1/n$ with coefficients being functions of $k$}{\relax }!coefficient?\glossarysubentryfield{1}{coefficient}{\glsnamefont{coefficient}}{a function of $k$ that appears as the coefficient of a $1/n$ power in a $1/n$-asymptotic expansion}{\relax }|setentrycounter[]{page}\glsnumberformat}{105}
\glossaryentry{asymptotic expansion?\glossaryentryfield{asymptotic expansion}{\glsnamefont{$1/n$-asymptotic expansion}}{an asymptotic expansion of a function $f(k,n)$ in powers of $1/n$ with coefficients being functions of $k$}{\relax }|setentrycounter[]{page}\glsnumberformat}{105}
\glossaryentry{fundamental order?\glossaryentryfield{fundamental order}{\glsnamefont{fundamental order of $B$}}{the order of the smallest strict tangle in $B$}{\relax }|setentrycounter[]{page}\glsnumberformat}{117}
\glossaryentry{tangle of B?\glossaryentryfield{tangle of B}{\glsnamefont{tangle of $B$}}{a graph, $\psi \in \Occurs _B$ for which $\rho (H_\psi )\ge \rhoroot B$}{\relax }!strict tangle of B?\glossarysubentryfield{1}{strict tangle of B}{\glsnamefont{strict tangle of $B$}}{a graph, $\psi $, in $\Occurs _B$ for which $\rho (H_\psi )> \rhoroot B$}{\relax }|setentrycounter[]{page}\glsnumberformat}{117}
\glossaryentry{B-Ramanujan function?\glossaryentryfield{B-Ramanujan function}{\glsnamefont{$B$-Ramanujan function}}{a function with a polyexponential part in the eigenvalues $\mu _i(B)$ and an error term}{\relax }|setentrycounter[]{page}\glsnumberformat}{123}
