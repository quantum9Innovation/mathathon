  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/GAUL2CLY/Markowitz et al. - 2018 - The Striatum Organizes 3D Behavior via Moment-to-M.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/45RKKGFC/S0092-8674(18)30512-9.html}
