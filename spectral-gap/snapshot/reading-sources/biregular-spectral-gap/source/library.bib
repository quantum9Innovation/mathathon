  pages = {1-6},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/L7WZNKWU/Kung and Wu - 2012 - Perturbation regulated kernel regressors for super.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/9I7Z3B6Q/6349743.html}
