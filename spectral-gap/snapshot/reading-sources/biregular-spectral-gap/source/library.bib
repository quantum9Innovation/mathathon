  pages = {525-536},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/FDHC78AZ/Bartlett - 1998 - The sample complexity of pattern classification wi.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/MHGGYM54/661502.html}
