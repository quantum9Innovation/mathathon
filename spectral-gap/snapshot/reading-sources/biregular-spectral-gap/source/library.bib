@article{durbin1954a,
  title = {Errors in {{Variables}}},
  volume = {22},
  issn = {0373-1138},
  doi = {10.2307/1401917},
  abstract = {Nous supposons avoir un \'echantillon de n paires d'observations correspondant au mod\`ele r\'egressif: y${'}$ = $\beta$x${'}$ + $\xi$. Nous d\'esirons calculer approximativement $\beta$. Il est bien connu que quand les observations de x${'}$ contiennent des erreurs de mesure, le calcul approximatif de $\beta$ se trouve fauss\'e. Le probl\`eme de trouver une valeur satisfaisante de $\beta$ est un vieux probl\`eme dans la th\'eorie des r\'egressions; il a \'et\'e trait\'e par de nombreux auteurs. Cet article envisage trois diff\'erentes mani\`eres de traiter le probl\`eme: celle de Berkson, l'emploi de variables auxiliaires et la m\'ethode classique. Berkson a montr\'e que, dans certains cas d'exp\'eriences scientifiques, les erreurs d'observation se conduisent de telle mani\`ere que la valeur ordinaire de $\beta$ ne s'en trouve pas fauss\'ee. Dans une certaine mesure des cas semblables peuvent se pr\'esenter en \'econom\'etrie. Il est, par cons\'equent, n\'ecessaire d'examiner la nature de ces erreurs avant de conclure que l'estimation de $\beta$ est s\'erieusement erron\'ee. Dans les cas o\`u la m\'ethode de Berkson ne s'applique pas, l'erreur sur $\beta$ peut parfois \^etre r\'eduite par l'emploi de variables auxiliaires. Soit z une variable en corr\'elation avec x${'}$ mais non avec l'erreur d'observation sur x${'}$: alors on appelle z une variable auxiliaire. Des variables auxiliaires appropri\'ees sont propos\'ees dans ce rapport. La m\'ethode classique, telle qu'elle a \'et\'e d\'efinie par Koopmans et Tintner pr\'esente le d\'esavantage qu'une connaissance de la matrice de variance des erreurs est requise. Cette connaissance fait ordinairement d\'efaut en pratique.},
  number = {1/3},
  journal = {Revue de l'Institut International de Statistique / Review of the International Statistical Institute},
  author = {Durbin, J.},
  year = {1954},
  pages = {23-32},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/PEYP7KP9/Durbin - 1954 - Errors in Variables.pdf}
}

