  pages = {930-945},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/C9UAGKNK/Barron - 1993 - Universal approximation bounds for superpositions .pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/EN5ECPW3/abs_all.html}
}

@article{mori2006,
