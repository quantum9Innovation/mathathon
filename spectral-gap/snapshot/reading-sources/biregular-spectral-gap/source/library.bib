  volume = {118},
  issn = {0012-7094, 1547-7398},
  doi = {10.1215/S0012-7094-03-11812-8},
  abstract = {Let GGG be a fixed graph with largest (adjacency matrix) eigenvalue $\lambda$0$\lambda$0$\backslash$lambda$\backslash$sb 0 and with its universal cover having spectral radius rhorhorho. We show that a random cover of large degree over GGG has its "new" eigenvalues bounded in absolute value by roughly $\lambda$0$\rho$---$\surd\lambda$0$\rho\backslash$sqrt\{$\backslash$lambda$\backslash$sb 0$\backslash$rho\}. This gives a positive result about finite quotients of certain trees having "small" eigenvalues, provided we ignore the "old" eigenvalues. This positive result contrasts with the negative result of A. Lubotzky and T. Nagnibeda which showed that there is a tree all of whose finite quotients are not "Ramanujan" in the sense of Lubotzky, R. Phillips, and P. Sarnakand of Y. Greenberg. Our main result is a "relative version" of the Broder-Shamir bound on eigenvalues of random regular graphs. Some of their combinatorial techniques are replaced by spectral techniques on the universal cover of GGG. For the choice of GGG that specializes our main theorem to the Broder-Shamir setting, our result slightly improves theirs.},
  language = {en},
  number = {1},
  journal = {Duke Mathematical Journal},
  author = {Friedman, Joel},
  month = may,
  year = {2003},
  pages = {19-35},
