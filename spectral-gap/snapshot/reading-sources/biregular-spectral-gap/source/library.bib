@article{kim2008,
  title = {Nonnegative {{Matrix Factorization Based}} on {{Alternating Nonnegativity Constrained Least Squares}} and {{Active Set Method}}},
  volume = {30},
  issn = {0895-4798},
  doi = {10.1137/07069239X},
  abstract = {Nonnegative matrix factorization (NMF) determines a lower rank approximation of a matrix \$A $\backslash$in $\backslash$mathbb\{R\}\^\{m $\backslash$times n\} $\backslash$approx WH\$ where an integer \$k $\backslash$ll $\backslash$min(m,n)\$ is given and nonnegativity is imposed on all components of the factors \$W $\backslash$in $\backslash$mathbb\{R\}\^\{m $\backslash$times k\}\$ and \$H $\backslash$in $\backslash$mathbb\{R\}\^\{k $\backslash$times n\}\$. NMF has attracted much attention for over a decade and has been successfully applied to numerous data analysis problems. In applications where the components of the data are necessarily nonnegative, such as chemical concentrations in experimental results or pixels in digital images, NMF provides a more relevant interpretation of the results since it gives nonsubtractive combinations of nonnegative basis vectors. In this paper, we introduce an algorithm for NMF based on alternating nonnegativity constrained least squares (NMF/ANLS) and the active set\textendash{}based fast algorithm for nonnegativity constrained least squares with multiple right-hand side vectors, and we discuss its convergence properties and a rigorous convergence criterion based on the Karush\textendash{}Kuhn\textendash{}Tucker (KKT) conditions. In addition, we also describe algorithms for sparse NMFs and regularized NMF. We show how we impose a sparsity constraint on one of the factors by \$L\_1\$-norm minimization and discuss its convergence properties. Our algorithms are compared to other commonly used NMF algorithms in the literature on several test data sets in terms of their convergence behavior.},
  number = {2},
  journal = {SIAM Journal on Matrix Analysis and Applications},
  author = {Kim, H. and Park, H.},
  month = jan,
  year = {2008},
  pages = {713-730},
  file = {/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/6LLMUBIQ/Kim and Park - 2008 - Nonnegative Matrix Factorization Based on Alternat.pdf;/home/kameron/.zotero/zotero/nbstec6y.default/zotero/storage/IX3LPGJJ/07069239X.html}
}

