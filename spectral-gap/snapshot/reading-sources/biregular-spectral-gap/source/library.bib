  doi = {10.1016/0024-3795(81)90150-6},
  abstract = {Let K1, K2,... be a sequence of regular graphs with degree v$\geqslant$2 such that n(Xi)$\rightarrow\infty$ and ck(Xi)/n(Xi)$\rightarrow$0 as i$\infty$ for each k$\geqslant$3, where n(Xi) is the order of Xi, and ck(Xi) is the number of k- cycles in X1. We determine the limiting probability density f(x) for the eigenvalues of X$>$i as i$\rightarrow\infty$. It turns out that f(x)=v4(v-1)-v22$\pi$(v2-x2)0 for $\nparallel$x$\nparallel\leqslant$2v-1, otherwise It is further shown that f(x) is the expected eigenvalue distribution for every large randomly chosen labeled regular graph with degree v.},
