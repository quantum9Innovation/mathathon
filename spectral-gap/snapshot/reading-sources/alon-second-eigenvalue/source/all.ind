\begin{theindex}

  \item [$a_j$:] {the number of $\pi _j$ and $\pi _j^{-1}$ appearing in a word or form}, 
		45, 49, 53

  \indexspace

  \item [bead:] {a vertex with indegree and outdegree $1$ (or, for undirected graphs, degree $2$) with no self-loops}, 
		21

  \indexspace

  \item [$c_G(u,v;k)$:] {the number of walks of length $k$ from $u$ to $v$ in $G$}, 
		22
  \item [closed walk:] {a walk beginning and ending at the same vertex}, 
		5
  \item [critical:] { a tangle with $\lambda _{{\rm  Irred}_{}}=\sqrt  {d-1}$}, 
		35

  \indexspace

  \item [E\char '133$\Gamma $\char '135$_n$:] {The expected value of the number of closed walks corresponding to a potential walk class (which depends only the the form of the potential walk)}, 
		53
  \item [expansion polynomials:] {The polynomials $p_i=p_i(a_1,\ldots  ,a_{d/2},v)$ giving the $1/n$ expansion of ${\rm  E}_{\rm  symm}(w,\mathaccentV {vec}17Et\mskip \medmuskip )$}, 
		45

  \indexspace

  \item [form:] {an oriented, $\Pi $-labelled graph with edges and vertices numbered that is meant to represent the graph traced out by a potential word, forgetting about the particular choices in ${\{1,\ldots  ,n\}}$ of the vertices}, 
		52

  \indexspace

  \item [generating function:] {a power series, $\Sigma _k a_k z^k$, formed from coefficients $a_k$}, 
		24
  \item [$G_{{\rm  Irred}_{}}$:] {edge graph of $G$ with edges joined only when they form an irreducible path}, 
		27
  \item [${\cal  G}_{n,d}$:] {space of random graphs formed from $d/2$ permutations}, 
		2
  \item [graph:] {a directed graph with a origin/terminal reversing pairing of its edges}, 
		20

  \indexspace

  \item [half-loop:] {a self-loop paired with itself (in a graph)}, 20
  \item [${\cal  H}_{n,d}$:] {random graph space formed by $d/2$ permutations that are cycles of length $n$}, 
		3
  \item [hypercritical:] { a tangle with $\lambda _{{\rm  Irred}_{}}>\sqrt  {d-1}$}, 
		35

  \indexspace

  \item [${\cal  I}_{n,d}$:] {random graph model of $d$ perfect matchings ($n$ even)}, 
		3
  \item [${\rm  IrredTr}\left (A,k\right )$:] {the number of closed irreducible walks of length $k$ in the graph underlying $A$}, 
		8
  \item [irreducible:] { a walk (resp.\ word) that has no consecutive steps of an edge (resp.\ letter) and its inverse}, 
		5
  \item [${\rm  IrSelTr}_{S,{\Psi }}(G;k)$:] { $k$-th irreducible $(S,{\Psi })$-selective trace of $G$, i.e., the number of irreducible closed walks of length $k$ in $G$ such that no subpath of length at most $S$ traces out a tangle in ${\Psi }$}, 
		59

  \indexspace

  \item [${\cal  J}_{n,d}$:] {random graph model formed from $d$ permutations each with exactly one fixed point ($n$ odd)}, 
		4

  \indexspace

  \item [$\lambda _i(G)$:] {$i$-th largest eigenvalue of the adjacency matrix of a finite graph}, 
		1
  \item [$\lambda _1(G)$:] {the sup over all values $( c_G(v,v;k))^k$}, 
		23
  \item [$\lambda _{{\rm  Irred}_{}}(G)$:] {the largest eigenvalue of $G_{{\rm  Irred}_{}}$}, 
		28

  \indexspace

  \item [new type:] {a type with some additional information specified, such as a partition of the types edges into a ``long'' and a ``fixed'' edge set}, 
		55

  \indexspace

  \item [$\Omega $-type:] { a generalization of type that incorporates information of an included tangle, $\Omega $}, 
		87

  \indexspace

  \item [$p_i= p_i(a_1,\ldots  ,a_{d/2},v)$:] {the expansion polynomials}, 
		45

  \indexspace

  \item [supercritical:] { a tangle with $\lambda _{{\rm  Irred}_{}}\ge \sqrt  {d-1}$}, 
		35

  \indexspace

  \item [${\tau _{\rm  fund}}$:] {smallest order of a supercritical tangle}, 
		2, 3
  \item [type:] {a graph representing a number of forms, where we forget certain features of the form, such as its $\Pi $-labelling and all or almost all its degree two vertices}, 
		54

  \indexspace

  \item [variable-length graph (VLG):] {a graph, directed or undirected, with a positive integral ``length'' associated to each edge}, 
		21
  \item [VLG:] {variable-length graph}, 21

  \indexspace

  \item [$W_\Gamma ,W_T,W_{T'}$:] {the number of potential walk classes or legal walks on a form, type, or new type with various additional restrictions (such as irreducibility)}, 
		53, 60
  \item [whole-loop:] {two self-loops (about the same vertex) paired with each other (in a graph)}, 
		20

\end{theindex}
