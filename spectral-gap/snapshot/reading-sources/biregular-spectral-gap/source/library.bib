@article{payne2011,
  archivePrefix = {arXiv},
  eprinttype = {arxiv},
  eprint = {1103.0056},
  title = {Exact Solutions for Social and Biological Contagion Models on Mixed Directed and Undirected, Degree-Correlated Random Networks},
  volume = {84},
  issn = {1539-3755, 1550-2376},
  doi = {10.1103/PhysRevE.84.016110},
  abstract = {We derive analytic expressions for the possibility, probability, and expected size of global spreading events starting from a single infected seed for a broad collection of contagion processes acting on random networks with both directed and undirected edges and arbitrary degree-degree correlations. Our work extends previous theoretical developments for the undirected case, and we provide numerical support for our findings by investigating an example class of networks for which we are able to obtain closed-form expressions.},
  number = {1},
